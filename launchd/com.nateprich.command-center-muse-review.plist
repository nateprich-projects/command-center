<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The escalated reviewer. The canonical copy lives here in the repo.

  It was meant to be symlinked into ~/Library/LaunchAgents so drift would be
  impossible. **launchd refuses a symlinked plist** — `Bootstrap failed: 5:
  Input/output error`, measured 2026-09-07 — so the installed file is a copy,
  and a copy drifts. `tests/test_launchd_drift.py` compares them and blocks a
  merge when they differ, which is the same treatment the Codex automations get.

  After editing this file, re-install it:
    cp launchd/com.nateprich.command-center-muse-review.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.nateprich.command-center-muse-review
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nateprich.command-center-muse-review.plist

  Meta ships `muse exec` as its own headless mode and Muse Code has no scheduler,
  so launchd is the sanctioned way to run this. AGENTS.md carries the carve-out:
  the never-headless rule is vendor-specific to Claude Code and Codex.

  Interval is a starting point, not a measurement. Escalated work is rare — 2 of
  30 startable tickets on 2026-09-07 — but the failure it fixes was two
  merge-ready PRs idle for two hours. Fifteen minutes matches the other pollers.
  Nate intends to calculate the real interval from usage once there is a few
  weeks of it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nateprich.command-center-muse-review</string>

    <!--
      `/bin/bash <script>`, not the script directly, because launchd cannot
      execute a file it can only read.

      This job was blocked until 2026-09-07. A launchd agent could not reach
      `/Volumes/External SSD`, where this repository used to live: reading a
      file, running a script and even `ls` all returned `Operation not
      permitted`, and a background job cannot answer the TCC prompt that would
      grant access. Interactive sessions were never affected — they inherit the
      grants of whatever launched them, which is why Muse worked by hand and
      why Codex and zcode, scheduled inside their own apps, never met this.

      Resolved by moving the checkout to `~/.claude/command-center` as a real
      directory rather than a symlink into the volume. Verified: this job now
      exits 0 on a scheduled run.

      After editing this file, re-install it:
        cp launchd/com.nateprich.command-center-muse-review.plist ~/Library/LaunchAgents/
        launchctl bootout gui/$(id -u)/com.nateprich.command-center-muse-review
        launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nateprich.command-center-muse-review.plist
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nateprich/.claude/command-center/scripts/muse-review</string>
    </array>

    <key>StartInterval</key>
    <integer>900</integer>

    <!-- Do not fire on load. A run at login competes with whatever Nate is
         doing at the moment he sits down, and the queue is almost always
         empty. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/nateprich/Library/Logs/command-center-muse-review.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nateprich/Library/Logs/command-center-muse-review.err.log</string>

    <!-- `gh` and `python3` are found on PATH; launchd's default PATH is minimal. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/nateprich/.local/bin</string>
        <key>HOME</key>
        <string>/Users/nateprich</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

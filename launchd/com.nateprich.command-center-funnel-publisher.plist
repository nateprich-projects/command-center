<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Funnel dashboard publisher (#652, step 3 of #643). Every minute it pushes
  the newest funnel spool snapshot to the Cloudflare KV key the Worker reads,
  and polls the refresh flag the page's refresh button sets. A set flag runs
  one funnel.py brief only when the newest snapshot is older than 10 minutes,
  then clears the flag. Failures go to this job's own log files below and
  never touch agent runs.

  The canonical copy lives here in the repo. launchd refuses a symlinked plist
  (`Bootstrap failed: 5: Input/output error`, measured 2026-09-07), so the
  installed file is a copy and `tests/test_launchd_drift.py` compares them.

  StartInterval, not the keeper's calendar schedule: this is a poll loop where
  seconds of drift are immaterial, and a calendar schedule would need 60
  entries to say "every minute". Overlap between a slow tick and the next is
  handled inside publisher.py with a lockfile, not by the schedule.

  The interpreter is pinned to /usr/bin/python3 (3.9, verified to run
  funnel.py and this script) rather than PATH's python3 so a future homebrew
  python cannot silently change what the job runs under. publisher.py invokes
  the brief through the same interpreter.

  Note for editors: XML forbids a double hyphen inside a comment. Use an em dash
  or a semicolon; plutil accepts the double hyphen and plistlib rejects it, so a
  file can lint clean and still be unparseable.

  After editing, re-install from a Terminal in the logged-in console session:
    cp launchd/com.nateprich.command-center-funnel-publisher.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.nateprich.command-center-funnel-publisher
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nateprich.command-center-funnel-publisher.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nateprich.command-center-funnel-publisher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/nateprich/.claude/command-center-run/publisher.py</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/nateprich/Library/Logs/command-center-funnel-publisher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nateprich/Library/Logs/command-center-funnel-publisher.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/nateprich/.local/bin</string>
        <key>HOME</key>
        <string>/Users/nateprich</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

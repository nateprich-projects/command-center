<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The shadow reviewer: one standard Muse review run that records its judgement
  but applies nothing.

  This schedule runs beside the old routine, the standard reviewer, during
  the shadow period required before the #794 cutover. The engine records its
  answer on the PR and in the finish note; the live review path remains
  unchanged.
  It runs at `high` effort, the same as the live standard reviewer it is
  measured against, so the agreement rate compares the engine rather than the
  effort level. The engine's own default is `max` (#976).

  The canonical copy lives here in the repo. launchd refuses a symlinked plist
  (`Bootstrap failed: 5: Input/output error`, measured 2026-09-07), so the
  installed file is a copy and `tests/test_launchd_drift.py` compares them.

  `/bin/bash <script>`, not the script directly: this repository used to live
  on an external volume that a launchd job could not read at all. It now lives
  on the internal disk, but invoking through bash costs nothing and survives a
  move.

  Note for editors: XML forbids a double hyphen inside a comment. Use an em dash
  or a semicolon; plutil accepts the double hyphen and plistlib rejects it, so a
  file can lint clean and still be unparseable.

  After editing, re-install:
    cp launchd/com.nateprich.command-center-muse-review-shadow.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.nateprich.command-center-muse-review-shadow
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nateprich.command-center-muse-review-shadow.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nateprich.command-center-muse-review-shadow</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nateprich/.claude/command-center-run/scripts/muse-review-engine</string>
        <string>--shadow</string>
        <string>standard</string>
        <string>high</string>
    </array>

    <!--
      Every five minutes, identical to the standard review routine. Running
      beside the old routine gives the engine a shadow record for every
      standard review slot without changing the live review path.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>5</integer></dict>
        <dict><key>Minute</key><integer>10</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>20</integer></dict>
        <dict><key>Minute</key><integer>25</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>35</integer></dict>
        <dict><key>Minute</key><integer>40</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
        <dict><key>Minute</key><integer>50</integer></dict>
        <dict><key>Minute</key><integer>55</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/nateprich/Library/Logs/command-center-muse-review-shadow.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nateprich/Library/Logs/command-center-muse-review-shadow.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/nateprich/.local/bin</string>
        <key>HOME</key>
        <string>/Users/nateprich</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

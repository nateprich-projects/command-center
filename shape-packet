#!/usr/bin/env python3
"""shape-packet — print one read-only shape packet for an idea as JSON.

Usage: shape-packet <idea> --repo owner/name

Part of #794: the shape runner shows the model this packet and nothing
else. No writes; every GitHub call is a read.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import funnel
from engine.shape import packet_main as main

if __name__ == "__main__":
    caller = funnel.graphql_caller_for_command(
        ["shape-packet"] + sys.argv[1:]
    )
    with funnel.graphql_caller(caller):
        try:
            code = main()
        finally:
            funnel.report_api_cost()
    raise SystemExit(code)

#!/bin/bash
# A Muse reviewer: one run, one PR, then stop.
#
# Usage: muse-review [tier] [reasoning-effort]
#   tier   -- escalated (default) or standard; substituted into the routine
#   effort -- max (default) or high
#
# Two schedules use it: escalated hourly at max effort, standard every fifteen
# minutes at high. One script and one routine rather than two of each, because a
# second copy is a second thing to drift -- which is #52's whole subject.
#
# Invoked by launchd (com.nateprich.command-center-muse-review). Meta ships
# `muse exec` as its own documented headless mode, and Muse Code has no
# scheduler, so launchd is the sanctioned way to run this. `AGENTS.md`'s
# never-headless rule is vendor-specific to Claude Code and Codex; see the
# carve-out there before assuming this file breaks it.
#
# **The prompt is `routines/muse.md`, read at run time.** Not pasted, not
# synced, not copied. That removes the whole drift surface #52 exists for:
# there is no second copy to fall out of step with the repo.

set -uo pipefail

TIER="${1:-escalated}"
EFFORT="${2:-max}"
case "$TIER" in
  escalated|standard) ;;
  *) echo "muse-review: tier must be escalated or standard, got '$TIER'" >&2; exit 1 ;;
esac

# The maintained read-only clone (#171, #204), not Nate's working tree: the
# routine text and the funnel it invokes must come from the same checkout.
REPO="${MUSE_REVIEW_REPO:-/Users/nateprich/.claude/command-center-run}"
# The muse binary and the wall-clock bound are overridable for the test that
# proves the bound kills a hung run; the defaults are what launchd runs.
MUSE_BIN="${MUSE_BIN:-$HOME/.local/bin/muse}"
BOUND_SECONDS="${MUSE_REVIEW_BOUND_SECONDS:-1200}"
ROUTINE="$REPO/routines/muse.md"
# An empty directory on purpose. Muse roots its workspace at the working
# directory, so this is what it can see. Everything real is reached by absolute
# path through `gh` and `funnel.py`, read-only. Never point this at the repo:
# that is Nate's own tree with his uncommitted work in it.
WORKSPACE="$HOME/.claude/command-center-muse-workspace"

mkdir -p "$WORKSPACE" || exit 1

if [[ ! -r "$ROUTINE" ]]; then
  echo "muse-review: cannot read $ROUTINE — refusing to run without a prompt" >&2
  exit 1
fi

# Everything after the first `---` is the agent-facing prompt; the header above
# it is written for a human reading the file. Same shape as the other routines.
# Breakdown rides with the standard tier, not with escalated. It is mechanical
# work, so it belongs on the frequent cheaper-effort schedule rather than the
# hourly one at max effort -- and the escalated schedule exists so rare risky
# reviews are never left waiting, which a breakdown would delay by minutes.
FLAGS="--tier $TIER"
if [[ "$TIER" == "standard" ]]; then
  FLAGS="$FLAGS --breakdown"
fi

PROMPT="$(awk 'f{print} /^---$/{f=1}' "$ROUTINE" | sed "s/OPENING_FLAGS/$FLAGS/g")"
if printf '%s' "$PROMPT" | grep -q OPENING_FLAGS; then
  echo "muse-review: the opening-flags placeholder was not substituted" >&2
  exit 1
fi
if [[ -z "${PROMPT// }" ]]; then
  echo "muse-review: $ROUTINE has no prompt after its --- separator" >&2
  exit 1
fi

# --model muse-spark-1.3, NOT -contributor. The contributor variant is the CLI
# default and carries "Your content ... may be used for product improvement".
# This repository is private and holds Nate's plans, budgets and decisions, and
# privacy is why he chose Muse in the first place. Both were confirmed working
# on his plan on 2026-09-07; this is the one without the notice.
#
# --sandbox-network enabled is required, not optional: the default is
# `proxy-only`, under which `gh` fails with `context deadline exceeded` after
# about a minute and reports the PR as unreadable.
#
# --disable-write blocks non-shell workspace writes. It is not the whole safety
# story -- the routine being read-only by instruction is -- because
# --approval-mode never means *never ask*, not *never allow*.
#
# Wall-clock bound (#392). `--max-model-steps` caps steps, not time: a hung
# model stream or tool consumes no steps, and launchd runs one instance per
# job, so a run that never ends skips every scheduled run after it. Measured
# twice on 2026-09-09 — 1,128 minutes, then 2h31m — against a 0.3-minute
# median. Twenty minutes is an order of magnitude past any legitimate job.
# A killed run finishes `errored` with the kill in its note, resolved from the
# one open start, so the watchdog sees a run that was stopped, not one that
# vanished. Portable bash: macOS ships no coreutils `timeout`.
# `perl setpgrp` gives the run its own process group, so the bound can kill
# the whole tree (muse and any shell tool it spawned) with one signal. macOS
# ships perl and no `setsid`.
perl -e 'setpgrp(0, 0); exec @ARGV or die "exec: $!"' "$MUSE_BIN" exec \
  --model muse-spark-1.3 \
  --reasoning-effort "$EFFORT" \
  --disable-write \
  --sandbox-network enabled \
  --max-model-steps 60 \
  --no-foreign-personal-context \
  --workspace "$WORKSPACE" \
  --json \
  "$PROMPT" &
muse_pid=$!
killed_marker="$(mktemp "${TMPDIR:-/tmp}/muse-review-killed.XXXXXX")"
rm -f "$killed_marker"

(
  # Sleep in the background so a TERM to this subshell (the normal path, when
  # the run finished inside the bound) takes the sleep with it instead of
  # leaving an orphan holding the log pipe open for the rest of the bound.
  sleep "$BOUND_SECONDS" &
  sleep_pid=$!
  trap 'kill "$sleep_pid" 2>/dev/null; exit 0' TERM
  wait "$sleep_pid"
  if kill -0 "$muse_pid" 2>/dev/null; then
    echo "muse-review: killing run after ${BOUND_SECONDS}s ($TIER schedule)" >&2
    : > "$killed_marker"
    # Record the kill before the hard kill, so a run that dies slowly still
    # leaves an honest finish behind.
    python3 "$REPO/heartbeat.py" finish --agent muse --outcome errored \
      --note "killed after $((BOUND_SECONDS / 60)) minutes: $TIER schedule run exceeded the wall-clock bound (#392)" >&2
    kill -TERM -- "-$muse_pid" 2>/dev/null
    sleep 5
    kill -KILL -- "-$muse_pid" 2>/dev/null
  fi
) &
bound_pid=$!

wait "$muse_pid"
status=$?
if [[ -e "$killed_marker" ]]; then
  wait "$bound_pid" 2>/dev/null
  rm -f "$killed_marker"
  exit 124
fi
kill "$bound_pid" 2>/dev/null
wait "$bound_pid" 2>/dev/null
exit "$status"

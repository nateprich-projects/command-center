#!/bin/bash
# A judgement engine: one review, breakdown, or shape job against its packet,
# then stop. Muse answers by default; z.ai's GLM-5.3 answers the standard tier
# until 2026-10-07 00:00 Beijing time, 2026-10-06 09:00 PDT (below).
#
# Usage: muse-review-engine [tier] [reasoning-effort]
#   tier   -- escalated (default) or standard; substituted into begin
#   effort -- max (default) or high; Muse only, zai-exec takes none
#
# Phase 1 of #794: begin offers the work, the packet command assembles the
# evidence, and a failing review precheck is applied as rejected with no model
# call at all, except a non-OPEN PR stop, which records no verdict. A passing
# precheck whose merged overlap has no green run yet re-runs the PR's CI once
# and waits for the result instead of calling the model (#1019).
# Otherwise, review calls one lister and judges of at most three
# requirements each against the same cached packet — in parallel on Muse, one
# at a time on z.ai (#1411); the runner derives the
# verdict before handing the answer to review-apply. Breakdown and shape each
# answer one JSON question. Calls retry once on a parse error. Breakdown rides
# the standard tier only; shape follows wherever begin offers it.
#
# Two backends, one protocol. Everything above is the same whichever model
# answers; only the model call, the agent name on the records, and the
# provider-quota handling differ.
#
#  - Muse (`muse exec`, agent `muse`) runs with --disable-shell
#    --disable-write --disable-web-tools: it has no tool at all, so it cannot
#    run funnel.py or gh itself. No --sandbox-network flag: there are no tools
#    left that need the network, and the CLI's own provider calls work under
#    the default. No --approval-mode either: the default stays on-request, so
#    a future tool outside the three disables could never be silently
#    auto-allowed on this path.
#  - z.ai (`scripts/zai-exec`, agent `zcode`) posts one user message with no
#    `tools` array to GLM-5.3's Anthropic-compatible endpoint. There is no
#    tool to disable because none is ever offered, and it refuses any reply
#    that a model other than glm-5.3 answered (LEARNINGS.md, 2026-09-06).
#
# The standard tier routes to z.ai while now < 2026-10-07 00:00 Beijing time
# (1791302400, 2026-10-06 09:00 PDT), on Nate's decision of 2026-09-23:
# Muse's week was nearly spent until its Sunday 17:00 PDT reset, and his
# cancelled z.ai Coding Plan stays active until it expires on 2026-10-07, so
# its credits are use-it-or-lose-it. The cutoff is the start of the expiry day
# in z.ai's own time zone (UTC+8), the earliest reading of "expires
# 2026-10-07" (#1411): it gives up most of a day rather than risk runs
# erroring on an expired key. After it the standard tier is Muse's again with
# nothing to undo. The escalated tier never routes. heartbeat.py's
# ZAI_STANDARD_UNTIL is the same instant, and a test pins the two together.
# AGENTS.md carries the terms caveat: headless use of a Coding Plan key is his
# risk call on unread terms, as Muse's is.
#
# A separate runner from muse-implement on purpose: a flag error must never
# turn a reviewer into a writer.

set -uo pipefail

TIER="escalated"
EFFORT="max"
SEEN=0
for arg in "$@"; do
  case "$arg" in
    --*) echo "muse-review-engine: unknown flag '$arg'" >&2; exit 1 ;;
    *)
      SEEN=$((SEEN + 1))
      if (( SEEN == 1 )); then
        TIER="$arg"
      elif (( SEEN == 2 )); then
        EFFORT="$arg"
      else
        echo "muse-review-engine: usage: muse-review-engine [tier] [effort]" >&2
        exit 1
      fi
      ;;
  esac
done
case "$TIER" in
  escalated|standard) ;;
  *) echo "muse-review-engine: tier must be escalated or standard, got '$TIER'" >&2; exit 1 ;;
esac
case "$EFFORT" in
  max|high) ;;
  *) echo "muse-review-engine: reasoning effort must be max or high, got '$EFFORT'" >&2; exit 1 ;;
esac

# --- which backend answers this run (Nate, 2026-09-23) ------------------------
#
# Decided from the clock, not from a file or a flag in the plist: the plist
# keeps running `standard max`, and the routing lapses at the cutoff with
# nothing to remove. The cutoff is overridable only so the tests can drive
# both sides of it; a value that is not a plain epoch keeps the run on Muse,
# the behaviour this block did not exist to change.
#
# The agent name is `zcode`, the old z.ai lane's name (retired 2026-09-09,
# #431; its in-app routine stays retired): it spends
# the `zai` pool in usage.py and heartbeat.py already, so `begin` reads z.ai's
# own five-hour and weekly windows and stops the lane when either is spent.
# No fallback to Muse on a spent z.ai window: the standard lane records a skip
# and waits, and Muse's week is left to the escalated tier it was kept for.
ZAI_STANDARD_UNTIL="${MUSE_REVIEW_ENGINE_ZAI_UNTIL:-1791302400}"
BACKEND="muse"
AGENT="muse"
if [[ "$TIER" == "standard" && "$ZAI_STANDARD_UNTIL" =~ ^[0-9]+$ ]] \
  && (( $(date +%s) < ZAI_STANDARD_UNTIL )); then
  BACKEND="zai"
  AGENT="zcode"
fi

# The maintained read-only clone, not Nate's working tree: the routine text
# and the funnel it invokes must come from the same checkout.
REPO="${MUSE_REVIEW_ENGINE_REPO:-/Users/nateprich/.claude/command-center-run}"
# The muse, zai-exec and gh binaries and the wall-clock bound are overridable
# for the tests; the defaults are what the schedule runs. zai-exec is a
# sibling of this runner, like the quota-hold helper below.
MUSE_BIN="${MUSE_BIN:-$HOME/.local/bin/muse}"
ZAI_EXEC_BIN="${ZAI_EXEC_BIN:-${BASH_SOURCE[0]%/*}/zai-exec}"
MUSE_CALL_BIN="${MUSE_CALL_BIN:-$REPO/muse_call.py}"
GH_BIN="${GH_BIN:-gh}"
BOUND_SECONDS="${MUSE_REVIEW_ENGINE_BOUND_SECONDS:-1200}"
# zai-exec's own network deadline sits inside the bound, so a slow reply ends
# as zai-exec's diagnostic rather than as the bound's kill. The kill stays as
# the backstop.
if (( BOUND_SECONDS > 60 )); then
  ZAI_TIMEOUT_SECONDS=$((BOUND_SECONDS - 30))
else
  ZAI_TIMEOUT_SECONDS=$(( BOUND_SECONDS > 1 ? BOUND_SECONDS - 1 : 1 ))
fi
#: zai-exec's status for a spent z.ai window; see its docstring.
ZAI_QUOTA_EXIT=75
ROUTINE_REVIEW="$REPO/routines/muse-review.md"
ROUTINE_BREAKDOWN="$REPO/routines/muse-breakdown.md"
ROUTINE_SHAPE="$REPO/routines/muse-shape.md"
# An empty directory on purpose, shared with the old reviewer. The model has
# no tools so it cannot see this at all; it exists only because exec wants a
# workspace root.
WORKSPACE="$HOME/.claude/command-center-muse-workspace"

mkdir -p "$WORKSPACE" || exit 1

# Checked before begin, like the routines: a run must never take work it
# cannot ask about.
if [[ "$BACKEND" == "zai" && ! -x "$ZAI_EXEC_BIN" ]]; then
  echo "muse-review-engine: cannot execute $ZAI_EXEC_BIN — refusing to run the z.ai standard tier without it" >&2
  exit 1
fi

# One prompt per job, all checked before begin: a run must never take work
# it cannot ask about. Everything after the first `---` is the agent-facing
# prompt; the header above it is written for a human reading the file. Same
# shape as the other routines. The packet goes where PACKET_JSON stands,
# exactly once: a second occurrence would mean the substitution below left a
# literal behind.
check_routine() {
  local file="$1"
  local template
  local placeholders
  if [[ ! -r "$file" ]]; then
    echo "muse-review-engine: cannot read $file — refusing to run without a prompt" >&2
    return 1
  fi
  template="$(awk 'f{print} /^---$/{f=1}' "$file")"
  if [[ "$template" != *[![:space:]]* ]]; then
    echo "muse-review-engine: $file has no prompt after its --- separator" >&2
    return 1
  fi
  placeholders="$(printf '%s' "$template" | grep -o PACKET_JSON | wc -l | tr -d ' ')"
  if [[ "$placeholders" != "1" ]]; then
    echo "muse-review-engine: $file must hold PACKET_JSON exactly once" >&2
    return 1
  fi
  printf '%s' "$template"
}

# Bare assignments, not `local x=$(...)`: the assignment keeps the
# substitution's status, so `if !` sees a bad routine.
if ! PROMPT_REVIEW="$(check_routine "$ROUTINE_REVIEW")"; then
  exit 1
fi
if ! PROMPT_BREAKDOWN="$(check_routine "$ROUTINE_BREAKDOWN")"; then
  exit 1
fi
if ! PROMPT_SHAPE="$(check_routine "$ROUTINE_SHAPE")"; then
  exit 1
fi
if [[ "$BACKEND" == "muse" && ! -r "$MUSE_CALL_BIN" ]]; then
  echo "muse-review-engine: cannot read $MUSE_CALL_BIN — continuing without Muse session capture" >&2
fi

# One owner-only directory per run, holding every scratch file including the
# packet, removed whole when the run ends (#1240). Two reasons it is a
# directory rather than six loose files in a shared temp root:
#
#  1. The packet carries the diff, the ticket text and the plan of a *member*
#     repository, and every member repository is private while this one is
#     public. `mktemp` gives each file mode 600, but the enclosing root is
#     world-listable, so the name, size and timing of a private review were
#     readable by any account on the machine. 700 on one directory closes
#     that without a mode argument on every file.
#  2. #1233 turns one model call into a lister plus several judges, all
#     reading the same assembled packet. A named directory is what they share.
#
# The root stays `${TMPDIR:-/tmp}` — runtime-relative, so nothing about this
# Mac's layout enters Git, and the rollback is to refetch from GitHub per
# call. Nothing here outlives the run: `GitHub is the state`.
RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/muse-review-engine.XXXXXX")"
if [[ -z "$RUN_DIR" || ! -d "$RUN_DIR" ]]; then
  echo "muse-review-engine: could not create the per-run scratch directory" >&2
  exit 1
fi
if ! chmod 700 "$RUN_DIR"; then
  # Refuse rather than continue: an unreadable-to-others directory is the
  # whole point, and a packet written into a widened one has already leaked.
  echo "muse-review-engine: could not make $RUN_DIR owner-only" >&2
  rmdir "$RUN_DIR" 2>/dev/null || true
  exit 1
fi
PACKET_FILE="$RUN_DIR/packet.json"
PROMPT_FILE="$RUN_DIR/prompt.txt"
ANSWER_FILE="$RUN_DIR/answer.json"
DECISION_FILE="$RUN_DIR/decision.json"
# The lister's canonical requirement list (#1241). One file per run, read
# by every judge that follows; never re-derived from the packet.
REQUIREMENTS_FILE="$RUN_DIR/requirements.json"
CHUNKS_FILE="$RUN_DIR/requirement-chunks.json"
# The helper is a sibling of this runner, not part of the maintained clone's
# protocol surface: it ships and moves with the script that sources it.
MUSE_QUOTA_HOLD_LIB="${BASH_SOURCE[0]%/*}/muse-quota-hold.sh"
if [[ ! -r "$MUSE_QUOTA_HOLD_LIB" ]]; then
  echo "muse-review-engine: cannot read $MUSE_QUOTA_HOLD_LIB — refusing to run without the quota hold" >&2
  exit 1
fi
. "$MUSE_QUOTA_HOLD_LIB"
DIAG_FILE="$RUN_DIR/diag.txt"
RESULT_FILE="$RUN_DIR/result.txt"

BEGIN_RUN=""

# The packet is assembled once per run and every later call reads these same
# bytes (#1240). Today the review path makes one model call; #1233 makes it a
# lister plus several judges, and a judge that refetched would be judging a
# different PR from the lister that enumerated it — the diff can move under a
# review, which is exactly what `precheck_verdict` exists to catch after the
# fact. Assembling twice is therefore a bug in the runner, not a slow path, so
# it fails loudly here rather than quietly costing a second fetch.
PACKET_ASSEMBLED=0

assemble_packet() {
  if (( PACKET_ASSEMBLED )); then
    echo "muse-review-engine: the packet was already assembled for this run;" \
      "every model call reads $PACKET_FILE" >&2
    return 2
  fi
  "$@" || return 1
  PACKET_ASSEMBLED=1
  return 0
}

# Keep the funnel's Project view in one disposable process for this Muse run.
# The server prints its loopback endpoint through an inherited pipe; it does
# not read GitHub until the first client command arrives, so `begin` still
# sees the live Project when it claims work. No endpoint or Project data is
# written to disk, and the session ends with this runner.
exec 3< <(
  FUNNEL_SESSION= FUNNEL_SESSION_SERVER=1 \
    python3 "$REPO/funnel.py" session-server --parent-pid "$$"
)
FUNNEL_SESSION=""
if ! IFS= read -r FUNNEL_SESSION <&3; then
  echo "muse-review-engine: could not start the per-run funnel session" >&2
  exec 3<&-
  exit 1
fi
exec 3<&-
export FUNNEL_SESSION

# Bind the heartbeat start to Muse's session when available. This is
# telemetry only: a missing id leaves usage unresolved, but must not stop the
# run it is meant to observe. Muse's alone: a z.ai run never sets it, so no
# zcode record can claim a Muse session.
#
# The z.ai run gets the same binding under zcode's own variable, which
# heartbeat reads as that agent's session and zai-exec uses to name its call
# log, so the run's calls land in one file heartbeat can read back.
#
# Only the run's first Muse call carries the id (#1413). `exec --session-id`
# with an id already used resumes that session's conversation, and one in
# use is refused. #1345 handed the one id to every call, so from 2026-09-23
# 21:33 PDT every parallel judge but one failed with "session ... is already
# in use", read `unsure`, and posted a false `rejected` on member-repo PRs;
# the one that ran judged with the lister's conversation replayed into it,
# and a parse retry resumed the failed attempt. The first call is the lister
# or the issue job's question, always in this shell and before any judge
# starts. The later calls, the parallel judges and a parse retry, run
# unbound under ids Muse assigns, so the run's recorded token usage covers
# the first call only: an undercount, not the whole run (#1413).
MUSE_SESSION_BOUND=0
if [[ "$BACKEND" == "muse" ]]; then
  if MUSE_SESSION_ID="$(python3 -c 'import uuid; print(uuid.uuid4())' 2>/dev/null)" \
    && [[ -n "$MUSE_SESSION_ID" ]]; then
    export MUSE_SESSION_ID
  else
    unset MUSE_SESSION_ID
    echo "muse-review-engine: no session id; continuing without session usage telemetry" >&2
  fi
else
  unset MUSE_SESSION_ID
  if ZCODE_SESSION_ID="$(python3 -c 'import uuid; print(uuid.uuid4())' 2>/dev/null)" \
    && [[ -n "$ZCODE_SESSION_ID" ]]; then
    export ZCODE_SESSION_ID
  else
    unset ZCODE_SESSION_ID
    echo "muse-review-engine: no session id; continuing without session usage telemetry" >&2
  fi
fi

cleanup() {
  python3 "$REPO/funnel.py" session-stop >/dev/null 2>&1 || true
  # The directory, not the files: a later call that adds a scratch file must
  # not have to be remembered here to be cleaned up.
  rm -rf -- "$RUN_DIR"
}
trap cleanup EXIT

# Keep one error shape for runner failures: the heartbeat gets the concise
# diagnostic, while the full stderr remains in the schedule's error log.
failure() {
  local note="$1"
  local muse_call_record
  local -a finish_args
  if [[ -z "$BEGIN_RUN" ]]; then
    echo "muse-review-engine: $note (no run id to finish)" >&2
    return 1
  fi
  finish_args=(finish --agent "$AGENT" --run "$BEGIN_RUN" \
    --outcome errored --note "$note")
  if [[ "$BACKEND" == "muse" ]]; then
    if ! muse_call_record="$(python3 "$MUSE_CALL_BIN" summarize "$RUN_DIR")"; then
      echo "muse-review-engine: could not summarize Muse call ids; finishing without them" >&2
      muse_call_record=""
    fi
    if [[ -n "$muse_call_record" ]]; then
      finish_args+=(--muse-call-record "$muse_call_record")
    fi
  fi
  if ! python3 "$REPO/heartbeat.py" "${finish_args[@]}"; then
    echo "muse-review-engine: could not finish errored run" >&2
    return 1
  fi
  return 0
}

finish_done() {
  local note="$1"
  local review_result="${2:-}"
  local result_path="${3:-}"
  local merged_pr="${4:-}"
  local -a finish_args=(
    finish --agent "$AGENT" --run "$BEGIN_RUN" --outcome done --note "$note"
  )
  if [[ -n "$result_path" && "$JOB" == "breakdown" ]]; then
    local ticket_count
    local needs_decision
    if ! ticket_count="$(python3 - "$result_path" <<'PY'
import json
import sys

result = json.load(open(sys.argv[1]))
question = result.get("needs_decision")
if question is not None:
    if not isinstance(question, str) or not question.strip():
        raise SystemExit("breakdown result has an invalid needs_decision")
    count = 0
else:
    created = result.get("created")
    if not isinstance(created, list):
        raise SystemExit("breakdown result has no created ticket list")
    count = len(created)
print(count)
PY
)"; then
      echo "muse-review-engine: could not read the live breakdown result" >&2
      exit 1
    fi
    if ! needs_decision="$(python3 - "$result_path" <<'PY'
import json
import sys

question = json.load(open(sys.argv[1])).get("needs_decision")
if question is None:
    print("")
elif isinstance(question, str) and question.strip():
    print(question)
else:
    raise SystemExit("breakdown result has an invalid needs_decision")
PY
)"; then
      echo "muse-review-engine: could not read the live breakdown question" >&2
      exit 1
    fi
    finish_args+=(--ticket-count "$ticket_count" --needs-decision "$needs_decision")
  elif [[ -n "$result_path" && "$JOB" == "shape" ]]; then
    local shape_status
    if ! shape_status="$(python3 - "$result_path" <<'PY'
import sys

status = ""
for line in open(sys.argv[1]).read().splitlines():
    if line.startswith("advanced to Ready: "):
        status = "Ready"
    elif line.startswith("held at Shaped: "):
        status = "Shaped"
if status not in {"Shaped", "Ready"}:
    raise SystemExit("shape result has no Shaped or Ready status")
print(status)
PY
)"; then
      echo "muse-review-engine: could not read the live shape result" >&2
      exit 1
    fi
    finish_args+=(--shape-status "$shape_status")
  fi
  if [[ "$review_result" == "approved" || "$review_result" == "rejected" ]]; then
    finish_args+=(--review-result "$review_result")
  fi
  if [[ "$BACKEND" == "muse" ]]; then
    local muse_call_record
    if ! muse_call_record="$(python3 "$MUSE_CALL_BIN" summarize "$RUN_DIR")"; then
      echo "muse-review-engine: could not summarize Muse call ids; finishing without them" >&2
      muse_call_record=""
    fi
    if [[ -n "$muse_call_record" ]]; then
      finish_args+=(--muse-call-record "$muse_call_record")
    fi
  fi
  if [[ -n "$merged_pr" ]]; then
    finish_args+=(--merged "$merged_pr")
  fi
  if ! python3 "$REPO/heartbeat.py" "${finish_args[@]}"; then
    echo "muse-review-engine: could not finish the run" >&2
    exit 1
  fi
}

finish_skipped_locked() {
  local note="$1"
  if ! python3 "$REPO/heartbeat.py" finish --agent "$AGENT" --run "$BEGIN_RUN" \
      --outcome skipped-locked --note "$note"; then
    echo "muse-review-engine: could not finish skipped-locked run" >&2
    exit 1
  fi
}

compact_json() {
  python3 -c '
import json
import sys

raw = open(sys.argv[1]).read()
limit = int(sys.argv[2])
try:
    flat = json.dumps(json.loads(raw), sort_keys=True)
except ValueError:
    flat = " ".join(raw.split())
if len(flat) > limit:
    flat = flat[:limit] + "…[truncated {} chars]".format(len(flat) - limit)
print(flat)
' "$1" "$2"
}

# --- which model may carry this repository's content (#1301) ------------------
#
# Muse's catalog marks `muse-spark-1.3-contributor` as `is_default: true`, so
# an exec with no `--model` runs on Meta's Discounted Services tier. The
# allowlist deciding which repositories may go there lives in one place,
# `muse_model.py`; this asks it about the repository this job is working.
#
# Fail closed. An empty or unrecognised answer becomes the private model,
# never an absent `--model`: an argv without the flag is the exact failure
# this whole change exists to prevent, so a broken resolver must not be able
# to produce one. MUSE_FALLBACK_MODEL is the last-resort anchor, not a second
# copy of the rule — it is only ever reached when muse_model.py cannot answer.
MUSE_FALLBACK_MODEL="muse-spark-1.3"

resolve_muse_model() {
  local subject="${1:-}" resolved known
  # Whitespace is stripped before the check, so a CRLF or a stray newline
  # cannot reach argv attached to an otherwise valid id. Muse accepts an
  # unrecognised model without complaining, so `muse-spark-1.3\r` would
  # not fail loudly — it would just stop meaning anything.
  resolved="$(python3 "$REPO/muse_model.py" model --repo "$subject" \
    2>/dev/null | tr -d '[:space:]')"
  # Membership, checked against the ids muse_model.py itself publishes
  # rather than a list written out here. A second copy in each runner
  # would reject a provider version bump the day the module accepted it,
  # and would do it silently.
  known="$(python3 "$REPO/muse_model.py" models 2>/dev/null)"
  # And the list is only trusted if it contains the private model. A
  # muse_model.py that is corrupt, half-written, or some other script
  # entirely answers both calls with the same wrong thing, and membership
  # against itself always passes; requiring the one id that must always
  # be there turns that back into a fallback.
  if [[ -n "$resolved" ]] \
    && printf '%s\n' "$known" | grep -qxF -- "$MUSE_FALLBACK_MODEL" \
    && printf '%s\n' "$known" | grep -qxF -- "$resolved"; then
    printf '%s\n' "$resolved"
  else
    printf '%s\n' "$MUSE_FALLBACK_MODEL"
  fi
}

# Recover the answer when session-id capture itself fails. The JSON stream is
# still the model's output, so an unavailable capture helper must not turn a
# successful call into an empty answer.
muse_answer_from_jsonl() {
  python3 - "$1" "$2" <<'PY'
import json
import pathlib
import sys

raw_path, answer_path = map(pathlib.Path, sys.argv[1:])
try:
    lines = raw_path.read_text(encoding="utf-8").splitlines()
except OSError as exc:
    raise SystemExit(str(exc))
answers = []
for index, line in enumerate(lines):
    try:
        event = json.loads(line)
    except (TypeError, ValueError):
        continue
    if not isinstance(event, dict) or event.get("payload_type") != \
            "run.terminal.completed":
        continue
    payload = event.get("payload")
    if not isinstance(payload, dict) or payload.get("terminal") != "completed":
        continue
    text = payload.get("text")
    if not isinstance(text, str):
        continue
    sequence = event.get("sequence")
    if isinstance(sequence, bool) or not isinstance(sequence, int):
        sequence = index
    answers.append((sequence, index, text))
answer_path.write_text(max(answers)[2] if answers else "", encoding="utf-8")
PY
}

# One model call: the prompt file in, the raw answer on stdout. Paths are
# arguments so the review judges can run in parallel without sharing answers
# or diagnostics. Plain kill, not a process-group kill: --disable-shell means
# the model can have no children to orphan, and zai-exec is one Python process
# making one HTTP request. Exit 124 when the bound kills it. The backend
# decides only which command runs; the bound, the files and the status are
# the same for both.
call_model_files() {
  local prompt_path="$1"
  local answer_path="$2"
  local diag_path="$3"
  local killed_marker
  local raw_answer_path=""
  local muse_capture_path=""
  local muse_call_first=0
  local muse_capture_initial="null"
  # Split from the declaration: `local x=$(...)` would mask mktemp's status.
  # In the run directory with everything else, so the EXIT trap's one `rm -rf`
  # sweeps it too. #1233 makes several model calls per run, so this name is
  # per-call rather than fixed.
  if ! killed_marker="$(mktemp "$RUN_DIR/killed.XXXXXX")"; then
    return 1
  fi
  rm -f "$killed_marker"
  if [[ "$BACKEND" == "zai" ]]; then
    # No model flag and no effort: zai-exec asks for glm-5.3 itself and
    # refuses a reply from anything else. No tool flags: it offers none.
    "$ZAI_EXEC_BIN" \
      --prompt-file "$prompt_path" \
      --timeout "$ZAI_TIMEOUT_SECONDS" >"$answer_path" 2>"$diag_path" &
  else
    # The id on the first call only; see the binding above (#1413).
    local -a muse_exec
    if (( MUSE_SESSION_BOUND == 0 )); then
      muse_exec=("${MUSE_EXEC[@]}")
      muse_capture_path="$RUN_DIR/muse-call-first"
      muse_call_first=1
      if [[ -n "${MUSE_SESSION_ID:-}" ]]; then
        muse_capture_initial="\"$MUSE_SESSION_ID\""
      fi
      if ! printf '%s\n' "$muse_capture_initial" >"$muse_capture_path"; then
        echo "muse-review-engine: cannot initialize the first Muse call capture slot; continuing without its id" >&2
        if [[ ! -e "$muse_capture_path" ]]; then
          muse_capture_path="$RUN_DIR/muse-call-first.${killed_marker##*/}"
          if ! printf '%s\n' "$muse_capture_initial" >"$muse_capture_path"; then
            echo "muse-review-engine: cannot create a fallback Muse call capture slot" >&2
            muse_capture_path=""
          fi
        fi
      fi
      MUSE_SESSION_BOUND=1
    else
      muse_exec=("${MUSE_EXEC_UNBOUND[@]}")
      if ! muse_capture_path="$(mktemp "$RUN_DIR/muse-call-later.XXXXXX")"; then
        echo "muse-review-engine: cannot allocate a Muse call capture slot; using a run-local fallback" >&2
        muse_capture_path="$RUN_DIR/muse-call-later.${killed_marker##*/}"
      fi
      if ! printf 'null\n' >"$muse_capture_path"; then
        echo "muse-review-engine: cannot initialize a Muse call capture slot; continuing without its id" >&2
        if [[ ! -e "$muse_capture_path" ]]; then
          muse_capture_path="$RUN_DIR/muse-call-later.fallback.${killed_marker##*/}"
          if ! printf 'null\n' >"$muse_capture_path"; then
            echo "muse-review-engine: cannot create a fallback Muse call capture slot" >&2
            muse_capture_path=""
          fi
        fi
      fi
    fi
    raw_answer_path="${answer_path}.muse-jsonl"
    "${muse_exec[@]}" \
      --reasoning-effort "$EFFORT" \
      --disable-shell \
      --disable-write \
      --disable-web-tools \
      --max-model-steps 60 \
      --no-foreign-personal-context \
      --workspace "$WORKSPACE" \
      --prompt-file "$prompt_path" >"$raw_answer_path" 2>"$diag_path" &
  fi
  local muse_pid=$!
  (
    sleep "$BOUND_SECONDS" &
    sleep_pid=$!
    trap 'kill "$sleep_pid" 2>/dev/null; exit 0' TERM
    wait "$sleep_pid"
    if kill -0 "$muse_pid" 2>/dev/null; then
      echo "muse-review-engine: killing run after ${BOUND_SECONDS}s ($TIER schedule)" >&2
      : > "$killed_marker"
      kill -TERM "$muse_pid" 2>/dev/null
      sleep 5
      kill -KILL "$muse_pid" 2>/dev/null
    fi
  ) &
  local bound_pid=$!
  wait "$muse_pid"
  local status=$?
  if [[ "$BACKEND" == "muse" ]]; then
    # Read the complete stream after this invocation stops. Background tool
    # results can arrive late, and parallel calls can complete out of order;
    # each invocation has its own capture slot.
    if [[ -n "$muse_capture_path" ]] \
      && ! python3 "$MUSE_CALL_BIN" capture "$raw_answer_path" "$answer_path" \
        "$muse_capture_path"; then
      echo "muse-review-engine: Muse session capture failed; keeping the model answer and marking the id uncaptured" >&2
      if ! muse_answer_from_jsonl "$raw_answer_path" "$answer_path"; then
        echo "muse-review-engine: could not recover the Muse model answer from its JSON stream" >&2
        return 1
      fi
      if (( muse_call_first )) && [[ -n "${MUSE_SESSION_ID:-}" ]]; then
        printf '"%s"\n' "$MUSE_SESSION_ID" >"$muse_capture_path" 2>/dev/null || true
      else
        printf 'null\n' >"$muse_capture_path" 2>/dev/null || true
      fi
    elif [[ -z "$muse_capture_path" ]]; then
      echo "muse-review-engine: no Muse call capture slot; continuing without its id" >&2
      if ! muse_answer_from_jsonl "$raw_answer_path" "$answer_path"; then
        echo "muse-review-engine: could not recover the Muse model answer from its JSON stream" >&2
        return 1
      fi
    fi
  fi
  if [[ -e "$killed_marker" ]]; then
    wait "$bound_pid" 2>/dev/null
    rm -f "$killed_marker"
    return 124
  fi
  kill "$bound_pid" 2>/dev/null
  wait "$bound_pid" 2>/dev/null
  rm -f "$killed_marker"
  return "$status"
}

call_model() {
  call_model_files "$PROMPT_FILE" "$ANSWER_FILE" "$DIAG_FILE"
}

# End the whole run as a z.ai quota skip: no verdict, no apply, no errored
# record, whichever call met the spent window — the lister, a judge, or an
# issue job's one question (#1411). Nothing is parked: z.ai publishes its
# windows, so the next `begin --agent zcode` reads the spent one and stops
# before any Project read, and the reset lifts it by itself. Never Muse's hold
# file either — a spent z.ai window must not park the escalated tier, which
# still has Muse's week to spend.
zai_quota_skip() {
  local diag_path="$1"
  local status="$2"
  local zai_reason
  zai_reason="$(grep -m 1 'zai-exec: quota-exhausted:' "$diag_path" 2>/dev/null \
    | sed 's/^zai-exec: quota-exhausted: //')"
  echo "muse-review-engine: z.ai's quota is exhausted; the standard lane stops until its window resets (${zai_reason:-no reason given})" >&2
  if [[ -n "${BEGIN_RUN:-}" ]]; then
    python3 "$REPO/heartbeat.py" finish --agent "$AGENT" --run "$BEGIN_RUN" \
      --outcome skipped-provider-quota \
      --note "z.ai quota exhausted: ${zai_reason:-zai-exec exit $status}" >&2 || true
  fi
  exit 0
}

model_failed() {
  local status="$1"
  # A spent provider window is not the subject's failure, on either backend.
  # z.ai says so with zai-exec's own status.
  if [[ "$BACKEND" == "zai" ]]; then
    if (( status == ZAI_QUOTA_EXIT )); then
      zai_quota_skip "$DIAG_FILE" "$status"
    fi
  # Muse: record the hold so every lane waits for the reset instead of
  # retrying on its own schedule.
  elif MUSE_QUOTA_RESET="$(muse_quota_record "$DIAG_FILE" "${BEGIN_RUN:-}")"; then
    echo "muse-review-engine: Muse's provider quota is exhausted; parking every lane until $MUSE_QUOTA_RESET" >&2
    if [[ -n "${BEGIN_RUN:-}" ]]; then
      local muse_call_record
      local -a quota_finish_args=(
        finish --agent "$AGENT" --run "$BEGIN_RUN"
        --outcome skipped-provider-quota
        --note "provider quota exhausted until $MUSE_QUOTA_RESET"
      )
      if ! muse_call_record="$(python3 "$MUSE_CALL_BIN" summarize "$RUN_DIR")"; then
        echo "muse-review-engine: could not summarize Muse call ids; finishing without them" >&2
        muse_call_record=""
      fi
      if [[ -n "$muse_call_record" ]]; then
        quota_finish_args+=(--muse-call-record "$muse_call_record")
      fi
      python3 "$REPO/heartbeat.py" "${quota_finish_args[@]}" >&2 || true
    fi
    exit 0
  fi
  if (( status == 124 )); then
    echo "muse-review-engine: the model call outlived the wall-clock bound" >&2
    failure "killed after $((BOUND_SECONDS / 60)) minutes: $TIER $JOB run exceeded the wall-clock bound (#392)" || true
    exit 124
  fi
  model_err="$(cat "$DIAG_FILE")"
  if [[ "$BACKEND" == "zai" ]]; then
    echo "muse-review-engine: zai-exec failed (exit $status): $model_err" >&2
    failure "zai-exec failed (exit $status) $FAIL_SUBJECT: $model_err" || true
    exit 1
  fi
  echo "muse-review-engine: muse exec failed (exit $status): $model_err" >&2
  failure "muse exec failed (exit $status) $FAIL_SUBJECT: $model_err" || true
  exit 1
}

# --- breakdown and shape: the standard-tier issue jobs -----------------------
# One shared path for both: no precheck, no head to pin. The packet is the
# plan or the idea, the model answers one JSON object with the same tool
# restrictions as review, a malformed answer retries once with the parse
# error fed back, and the apply performs every side effect. A malformed
# final answer records nothing — the project stays awaiting breakdown, the
# idea keeps its needs-shaping label — so the next run asks again.

fetch_issue_packet() {
  if [[ "$JOB" == "breakdown" ]]; then
    python3 "$REPO/breakdown-packet" "$BEGIN_REF" \
      >"$PACKET_FILE" 2>"$DIAG_FILE"
  else
    python3 "$REPO/shape-packet" "$SUBJECT_NUM" --repo "$SUBJECT_REPO" \
      >"$PACKET_FILE" 2>"$DIAG_FILE"
  fi
}

collect_issue_packet() {
  assemble_packet fetch_issue_packet
}

# One issue-job apply invocation; --run/--agent stamp the runner comments.
run_issue_apply() {
  local attempt="$1"
  shift
  if [[ "$JOB" == "breakdown" ]]; then
    python3 "$REPO/breakdown-apply" "$BEGIN_REF" --answer "$ANSWER_FILE" \
      --attempt "$attempt" "$@" --run "$BEGIN_RUN" --agent "$AGENT"
  else
    python3 "$REPO/shape-apply" "$SUBJECT_NUM" --repo "$SUBJECT_REPO" \
      --answer "$ANSWER_FILE" --attempt "$attempt" "$@" \
      --run "$BEGIN_RUN" --agent "$AGENT"
  fi
}

# The finish note for a live apply, read back from the apply's own report —
# never re-derived here, because the apply is what knows what it wrote.
issue_live_note() {
  python3 -c '
import json
import sys

job, ref, path = sys.argv[1], sys.argv[2], sys.argv[3]
if job == "breakdown":
    result = json.load(open(path))
    if result.get("already_answered"):
        print("broke down {}: the Gates question was already answered, "
              "nothing posted".format(ref))
    elif result.get("needs_decision"):
        print("broke down {}: asked a needs-decision question".format(ref))
    else:
        count = len(result.get("created", []))
        print("broke down {}: created {} ticket{}".format(
            ref, count, "" if count == 1 else "s"))
else:
    lines = open(path).read().splitlines()
    status = ""
    reason = ""
    for line in lines:
        if line.startswith("advanced to Ready: "):
            status, reason = "Ready", line[len("advanced to Ready: "):]
        elif line.startswith("held at Shaped: "):
            status, reason = "Shaped", line[len("held at Shaped: "):]
    if not status and lines and lines[0].startswith(ref + " "):
        status = lines[0].split(None, 2)[-1]
    note = "shaped {}: {}".format(ref, status or "applied")
    if reason:
        note += " ({})".format(reason[:300])
    print(note)
' "$JOB" "$BEGIN_REF" "$RESULT_FILE"
}

retry_issue_prompt() {
  parse_err="$(cat "$DIAG_FILE")"
  printf '%s\n\nYour previous answer could not be parsed: %s\nReply again with exactly one JSON object and nothing else.' \
    "$PROMPT" "$parse_err" >"$PROMPT_FILE"
}

run_issue_job() {
  # The packet is the only evidence the model ever sees. Reads only;
  # nothing here changes remote state.
  if ! collect_issue_packet; then
    packet_err="$(cat "$DIAG_FILE")"
    echo "muse-review-engine: $JOB-packet failed: $packet_err" >&2
    failure "$JOB-packet failed for $BEGIN_REF: $packet_err" || true
    exit 1
  fi
  if ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' \
      "$PACKET_FILE" 2>/dev/null; then
    echo "muse-review-engine: the $JOB packet for $BEGIN_REF is not valid JSON" >&2
    failure "$JOB-packet for $BEGIN_REF printed invalid JSON" || true
    exit 1
  fi

  # Substitute the whole packet where PACKET_JSON stands. The template check
  # above guarantees exactly one occurrence, so this cannot leave one behind —
  # and a packet that happens to contain the literal stays content, not a
  # placeholder. The prompt travels by --prompt-file, not argv, because a plan
  # can outgrow the argument limit.
  PACKET_JSON="$(cat "$PACKET_FILE")"
  PROMPT="${PROMPT_TEMPLATE//PACKET_JSON/$PACKET_JSON}"
  printf '%s' "$PROMPT" >"$PROMPT_FILE"

  ATTEMPT=1
  while true; do
    # Read the status into a variable: `$?` inside an `if !` branch is the
    # negated condition's status (0), not the call's.
    call_model
    muse_status=$?
    if (( muse_status != 0 )); then
      model_failed "$muse_status"
    fi
    # Read the status directly: `$?` after an `if` whose condition failed
    # is 0, never the apply exit, so the retryable 3 must be caught here.
    # (No `set -e`, so the bare failing call below does not abort the run.)
    run_issue_apply "$ATTEMPT" >"$RESULT_FILE" 2>"$DIAG_FILE"
    apply_status=$?
    if (( apply_status == 0 )); then
      if ! NOTE="$(issue_live_note)"; then
        NOTE="$JOB_PAST $BEGIN_REF: applied"
      fi
      finish_done "$NOTE" "" "$RESULT_FILE"
      exit 0
    fi
    if (( apply_status == 3 && ATTEMPT == 1 )); then
      retry_issue_prompt
      ATTEMPT=2
      continue
    fi
    apply_err="$(cat "$DIAG_FILE")"
    echo "muse-review-engine: $JOB-apply failed: $apply_err" >&2
    failure "$JOB-apply failed on $BEGIN_REF: $apply_err" || true
    exit 1
  done
}

# Park before claiming anything while Muse's provider quota is spent. The
# hold is written by whichever lane last met the refusal and expires by
# itself at the reset the provider named. It speaks for Muse only: a z.ai run
# spends a different pool, and `begin` gates it on z.ai's own windows.
if [[ "$BACKEND" == "muse" ]] \
  && MUSE_QUOTA_RESET="$(muse_quota_hold_until)"; then
  echo "muse-review-engine: parked until $MUSE_QUOTA_RESET — Muse's provider quota is exhausted" >&2
  exit 0
fi

# Own the opening poll. Empty polls must not launch a model: `begin` has
# already recorded the heartbeat and made the gate decision, so a stop can
# finish the run here without ever invoking `muse exec`.
#
# Breakdown rides with the standard tier, not with escalated — the same rule
# the old routine stated: it is mechanical work for the frequent schedule,
# and the escalated schedule exists so rare risky reviews never wait
# behind it. Shape needs no flag: begin offers a waiting
# idea on any tier once review and breakdown are empty.
BEGIN_FLAGS="--tier $TIER"
if [[ "$TIER" == "standard" ]]; then
  BEGIN_FLAGS="$BEGIN_FLAGS --breakdown"
fi
BEGIN_FLAGS="$BEGIN_FLAGS --role review"

begin_value() {
  local key="$1"
  printf '%s\n' "$BEGIN_JSON" | python3 -c '
import json
import sys

try:
    value = json.load(sys.stdin)[sys.argv[1]]
except (KeyError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
if value is None:
    raise SystemExit(1)
print(value)
' "$key"
}

begin_work_value() {
  local key="$1"
  printf '%s\n' "$BEGIN_JSON" | python3 -c '
import json
import sys

try:
    value = json.load(sys.stdin)["work"][sys.argv[1]]
except (KeyError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
if value is None:
    raise SystemExit(1)
print(value)
' "$key"
}

BEGIN_JSON="$(python3 "$REPO/funnel.py" begin --agent "$AGENT" $BEGIN_FLAGS)"
begin_status=$?
if (( begin_status != 0 )); then
  echo "muse-review-engine: funnel begin failed (exit $begin_status)" >&2
  if BEGIN_RUN="$(begin_value run)" && [[ -n "$BEGIN_RUN" ]]; then
    begin_why="$(begin_value why 2>/dev/null || true)"
    begin_note="funnel begin failed (exit $begin_status)"
    if [[ -n "$begin_why" ]]; then
      begin_note="$begin_note: $begin_why"
    fi
    failure "$begin_note" || true
  else
    echo "muse-review-engine: could not finish failed begin (no run id)" >&2
  fi
  exit "$begin_status"
fi

if ! BEGIN_DO="$(begin_value do)" \
  || ! BEGIN_GATE="$(begin_value gate)" \
  || ! BEGIN_RUN="$(begin_value run)"; then
  printf 'muse-review-engine: begin stdout (first 300 bytes):\n' >&2
  LC_ALL=C printf '%s' "$BEGIN_JSON" | LC_ALL=C head -c 300 >&2 || true
  printf '\n' >&2
  echo "muse-review-engine: funnel begin returned invalid JSON" >&2
  exit 1
fi

begin_stop_why() {
  printf '%s\n' "$BEGIN_JSON" | python3 -c '
import json
import sys

try:
    value = json.load(sys.stdin).get("why")
except ValueError:
    value = None
if not isinstance(value, str) or not value.strip():
    print("")
else:
    print(value)
'
}

if [[ "$BEGIN_DO" == "stop" ]]; then
  case "$BEGIN_GATE" in
    over) STOP_OUTCOME="skipped-over-pace" ;;
    # #1199: work is waiting and a tight budget is holding it. The same
    # outcome as a budget stop, with begin's numbers kept on the record.
    tight) STOP_OUTCOME="skipped-over-pace" ;;
    unknown) STOP_OUTCOME="skipped-usage-unknown" ;;
    reserve) STOP_OUTCOME="skipped-api-reserve" ;;
    *) STOP_OUTCOME="nothing-to-do" ;;
  esac
  BEGIN_WHY="$(begin_stop_why)"
  FINISH_ARGS=(finish --agent "$AGENT" --run "$BEGIN_RUN"
    --outcome "$STOP_OUTCOME")
  if [[ -n "$BEGIN_WHY" ]]; then
    echo "muse-review-engine: begin stopped: $BEGIN_WHY" >&2
    FINISH_ARGS+=(--note "$BEGIN_WHY")
  fi
  if ! python3 "$REPO/heartbeat.py" "${FINISH_ARGS[@]}"; then
    echo "muse-review-engine: could not finish the stopped run" >&2
    exit 1
  fi
  exit 0
fi

JOB="review"
FAIL_SUBJECT=""
if [[ "$BEGIN_DO" == "review" ]]; then
  if ! BEGIN_PR="$(begin_work_value pr)" \
    || ! BEGIN_REPO="$(begin_work_value repo)"; then
    echo "muse-review-engine: funnel begin returned unknown job '$BEGIN_DO'" >&2
    failure "funnel begin returned unknown job '$BEGIN_DO'" || true
    exit 1
  fi
  FAIL_SUBJECT="on PR #$BEGIN_PR in $BEGIN_REPO"
  PROMPT_TEMPLATE="$PROMPT_REVIEW"
elif [[ "$BEGIN_DO" == "breakdown" || "$BEGIN_DO" == "shape" ]]; then
  JOB="$BEGIN_DO"
  if ! BEGIN_REF="$(begin_work_value ref)"; then
    echo "muse-review-engine: funnel begin returned unknown job '$BEGIN_DO'" >&2
    failure "funnel begin returned unknown job '$BEGIN_DO'" || true
    exit 1
  fi
  SUBJECT_REPO="${BEGIN_REF%#*}"
  SUBJECT_NUM="${BEGIN_REF##*#}"
  if [[ "$SUBJECT_REPO" != */* || -z "$SUBJECT_NUM" ]] \
    || [[ "$SUBJECT_NUM" =~ [^0-9] ]]; then
    echo "muse-review-engine: funnel begin returned an unparseable ref '$BEGIN_REF'" >&2
    failure "funnel begin returned an unparseable ref '$BEGIN_REF'" || true
    exit 1
  fi
  FAIL_SUBJECT="on $JOB of $BEGIN_REF"
  if [[ "$JOB" == "breakdown" ]]; then
    PROMPT_TEMPLATE="$PROMPT_BREAKDOWN"
    JOB_PAST="broke down"
  else
    PROMPT_TEMPLATE="$PROMPT_SHAPE"
    JOB_PAST="shaped"
  fi
else
  echo "muse-review-engine: funnel begin returned unknown job '$BEGIN_DO'" >&2
  failure "funnel begin returned unknown job '$BEGIN_DO'" || true
  exit 1
fi

# Resolved once, from the repository this job works: the PR's repo for a
# review, the subject issue's repo for a breakdown or a shape. Both are in
# hand by here, so no job reaches `muse exec` without an answer. Muse only:
# the allowlist decides which repositories may reach Meta's contributor tier,
# and a z.ai run has one model, which zai-exec names and checks itself.
if [[ "$BACKEND" == "muse" ]]; then
  if [[ "$JOB" == "review" ]]; then
    MUSE_MODEL="$(resolve_muse_model "$BEGIN_REPO")"
  else
    MUSE_MODEL="$(resolve_muse_model "$SUBJECT_REPO")"
  fi
  # See muse-implement for why this is here and not only in the helper: a
  # command substitution that dies yields the empty string without stopping
  # the runner, and `--model ""` is an id Muse accepts without complaint.
  [[ -n "$MUSE_MODEL" ]] || MUSE_MODEL="$MUSE_FALLBACK_MODEL"
  # Keep the pin on the call arrays themselves: the repository-wide guard
  # treats each `exec` array as a call site and cannot connect a later flag.
  MUSE_EXEC=("$MUSE_BIN" exec --model "$MUSE_MODEL" --json)
  MUSE_EXEC_UNBOUND=("$MUSE_BIN" exec --model "$MUSE_MODEL" --json)
  if [[ -n "${MUSE_SESSION_ID:-}" ]]; then
    MUSE_EXEC+=(--session-id "$MUSE_SESSION_ID")
  fi
fi

if [[ "$JOB" != "review" ]]; then
  run_issue_job
  exit "$?"
fi

# The packet is the only evidence the model ever sees. Reads only; nothing
# here changes remote state.
fetch_review_packet() {
  python3 "$REPO/review-packet" "$BEGIN_PR" --repo "$BEGIN_REPO" \
    >"$PACKET_FILE" 2>"$DIAG_FILE"
}

if ! assemble_packet fetch_review_packet; then
  packet_err="$(cat "$DIAG_FILE")"
  echo "muse-review-engine: review-packet failed: $packet_err" >&2
  failure "review-packet failed for PR #$BEGIN_PR in $BEGIN_REPO: $packet_err" || true
  exit 1
fi

packet_field() {
  python3 -c '
import json
import sys

packet = json.load(open(sys.argv[1]))
field = sys.argv[2]
if field == "precheck_pass":
    print(packet.get("precheck", {}).get("pass", False))
elif field == "ci":
    print((packet.get("ci") or {}).get("state") or "unknown")
elif field == "ci_reason":
    ci = packet.get("ci") or {}
    print(ci.get("annotation") or "startup or account failure")
elif field == "head":
    print(packet.get("head_sha") or "")
elif field == "reason_count":
    print(len(packet.get("precheck", {}).get("reasons", [])))
elif field == "pr_not_open":
    print(any(str(reason).startswith("pr_not_open ")
              for reason in packet.get("precheck", {}).get("reasons", [])))
elif field == "pr_not_open_reason":
    for reason in packet.get("precheck", {}).get("reasons", []):
        if str(reason).startswith("pr_not_open "):
            print(reason)
            break
elif field == "covered_verdict_only":
    precheck = packet.get("precheck") or {}
    reasons = precheck.get("reasons") or []
    head_sha = packet.get("head_sha")
    expected = "verdict: a verdict already covers head {}".format(
        str(head_sha)[:12])
    covered = (isinstance(head_sha, str) and bool(head_sha)
               and packet.get("verdict") is not None
               and packet.get("verdict_head_sha") == head_sha)
    print(precheck.get("pass") is False and covered
          and reasons == [expected])
elif field == "rejected_answer":
    print(json.dumps({
        "verdict": "rejected",
        "blocking": packet.get("precheck", {}).get("reasons", []),
        "unsure": [],
        "requirements": [],
    }))
elif field == "ci_rerun_action":
    print((packet.get("ci_rerun") or {}).get("action") or "")
elif field == "ci_rerun_run":
    print((packet.get("ci_rerun") or {}).get("run_id") or "")
elif field == "ci_rerun_overlaps":
    overlaps = (packet.get("ci_rerun") or {}).get("overlaps") or []
    print(", ".join("#{}".format(pr) for pr in overlaps))
' "$PACKET_FILE" "$1"
}

if ! PACKET_PASS="$(packet_field precheck_pass)" \
  || ! PACKET_CI="$(packet_field ci)" \
  || ! PACKET_CI_REASON="$(packet_field ci_reason)" \
  || ! PACKET_HEAD="$(packet_field head)" \
  || ! PACKET_PR_NOT_OPEN="$(packet_field pr_not_open)" \
  || ! PACKET_COVERED_VERDICT_ONLY="$(packet_field covered_verdict_only)" \
  || ! CI_RERUN_ACTION="$(packet_field ci_rerun_action)" \
  || ! CI_RERUN_RUN="$(packet_field ci_rerun_run)" \
  || ! CI_RERUN_OVERLAPS="$(packet_field ci_rerun_overlaps)"; then
  echo "muse-review-engine: the packet for PR #$BEGIN_PR is not valid JSON" >&2
  failure "review-packet for PR #$BEGIN_PR in $BEGIN_REPO printed invalid JSON" || true
  exit 1
fi
HEAD_SHORT="${PACKET_HEAD:0:12}"
if [[ -z "$HEAD_SHORT" ]]; then
  HEAD_SHORT="unknown-head"
fi

# A startup or account stop is not a code-review verdict.  The run stays
# healthy and quiet until Actions recovers; recording rejection here would
# count the same untestable head against the auto-merge bar and hand the
# engineer a branch-shaped problem that no branch can fix.
if [[ "$PACKET_CI" == "could-not-run" ]]; then
  finish_done "review skipped PR #$BEGIN_PR in $BEGIN_REPO at $HEAD_SHORT: CI could not run: $PACKET_CI_REASON; no verdict recorded"
  exit 0
fi

if [[ "$PACKET_PASS" != "True" ]]; then
  if [[ "$PACKET_PR_NOT_OPEN" == "True" ]]; then
    if ! packet_field pr_not_open_reason >"$DECISION_FILE"; then
      echo "muse-review-engine: could not read the non-OPEN precheck reason" >&2
      failure "could not read the non-OPEN precheck reason for PR #$BEGIN_PR in $BEGIN_REPO" || true
      exit 1
    fi
    PR_NOT_OPEN_REASON="$(cat "$DECISION_FILE")"
    finish_done "review skipped PR #$BEGIN_PR in $BEGIN_REPO at $HEAD_SHORT: $PR_NOT_OPEN_REASON; no verdict recorded"
    exit 0
  fi
  # Row 4 already established that a verdict covers this head. Standing
  # down only when it is the sole failing row preserves that verdict without
  # changing the rejection path for a packet carrying another blocker.
  if [[ "$PACKET_COVERED_VERDICT_ONLY" == "True" ]]; then
    finish_done "review skipped — a verdict already covers head $HEAD_SHORT; no verdict recorded"
    exit 0
  fi
  # A failing precheck is applied as rejected with no model call at all. The
  # reasons become the blocking list through the same review-apply path a
  # model rejection takes, so the verdict shape never depends on who judged.
  if ! packet_field rejected_answer >"$ANSWER_FILE"; then
    echo "muse-review-engine: could not build the precheck rejection" >&2
    failure "could not build the precheck rejection for PR #$BEGIN_PR in $BEGIN_REPO" || true
    exit 1
  fi
  REASON_COUNT="$(packet_field reason_count)"
  ANSWER_NOTE="$(compact_json "$ANSWER_FILE" 4000)"
  if python3 "$REPO/review-apply" "$BEGIN_PR" --repo "$BEGIN_REPO" \
      --answer "$ANSWER_FILE" --ci "$PACKET_CI" --head "$PACKET_HEAD" \
      --attempt 1 --run "$BEGIN_RUN" --agent "$AGENT" >"$DIAG_FILE" 2>&1; then
    finish_done "reviewed PR #$BEGIN_PR in $BEGIN_REPO at $HEAD_SHORT: rejected without a model call ($REASON_COUNT precheck reason(s))" rejected
    exit 0
  fi
  apply_err="$(cat "$DIAG_FILE")"
  echo "muse-review-engine: review-apply refused the precheck rejection: $apply_err" >&2
  failure "review-apply refused the precheck rejection on PR #$BEGIN_PR in $BEGIN_REPO: $apply_err" || true
  exit 1
fi

# A passing precheck with a CI re-run outstanding: the branch is clean but
# no green run yet covers the merged overlap. Re-run CI once and wait for
# the result — no model call, no verdict — so the engineer needs no rebase
# (#1019). A failing precheck rejects first (above) and never reaches here.
# The finish notes carry no verdict word, because a healthy wait is not a
# verdict.
if [[ -n "$CI_RERUN_ACTION" ]]; then
  if [[ "$CI_RERUN_ACTION" != "rerun" && "$CI_RERUN_ACTION" != "wait" ]]; then
    echo "muse-review-engine: unknown ci_rerun action '$CI_RERUN_ACTION'" >&2
    failure "unknown ci_rerun action '$CI_RERUN_ACTION' for PR #$BEGIN_PR in $BEGIN_REPO; recorded nothing" || true
    exit 1
  fi
  if [[ "$CI_RERUN_ACTION" == "rerun" ]]; then
    if [[ ! "$CI_RERUN_RUN" =~ ^[0-9]+$ ]]; then
      echo "muse-review-engine: refusing to re-run CI without a run id" >&2
      failure "could not re-run CI for PR #$BEGIN_PR in $BEGIN_REPO (no run id in the packet); recorded nothing" || true
      exit 1
    fi
    if ! "$GH_BIN" run rerun "$CI_RERUN_RUN" --repo "$BEGIN_REPO" 2>"$DIAG_FILE"; then
      rerun_err="$(cat "$DIAG_FILE")"
      echo "muse-review-engine: gh run rerun failed: $rerun_err" >&2
      failure "could not re-run CI for PR #$BEGIN_PR in $BEGIN_REPO (gh run rerun $CI_RERUN_RUN failed: $rerun_err); recorded nothing" || true
      exit 1
    fi
    finish_done "review of PR #$BEGIN_PR in $BEGIN_REPO at $HEAD_SHORT re-ran CI (run $CI_RERUN_RUN) to cover merged overlap ($CI_RERUN_OVERLAPS); waiting for the result"
    exit 0
  fi
  if [[ -n "$CI_RERUN_RUN" ]]; then
    finish_done "review of PR #$BEGIN_PR in $BEGIN_REPO at $HEAD_SHORT waits for CI run $CI_RERUN_RUN covering merged overlap ($CI_RERUN_OVERLAPS)"
  else
    finish_done "review of PR #$BEGIN_PR in $BEGIN_REPO at $HEAD_SHORT waits for a CI run covering merged overlap ($CI_RERUN_OVERLAPS)"
  fi
  exit 0
fi

# Substitute the whole packet where PACKET_JSON stands. The template check
# above guarantees exactly one occurrence, so this cannot leave one behind —
# and a packet that happens to contain the literal stays content, not a
# placeholder. The prompt travels by --prompt-file, not argv, because a diff
# can outgrow the argument limit.
PACKET_JSON="$(cat "$PACKET_FILE")"
PROMPT="${PROMPT_TEMPLATE//PACKET_JSON/$PACKET_JSON}"

# --- the lister call (#1241) -------------------------------------------------
#
# One small question first: what does this diff have to do, and what must it
# avoid? The answer is a flat list of requirements drawn from the ticket, its
# parent plan and the repository's rules, and it judges nothing. #1242 splits
# the judging into calls of at most three requirements each, and every one of
# them reads this list rather than deriving its own — one canonical list is
# what keeps two judges of the same PR asking the same questions.
#
# Why a call of its own, when the judging prompt already asks the model to walk
# the requirements: difficulty, not size, is what silences `max` (#1233,
# measured 2026-09-21 — a terse format scored 0 of 3, a trimmed packet 0 of 3).
# Enumerating what a ticket asks for is the easy half of the old single call,
# and separating it is what leaves the hard half small enough to finish.
#
# The framing below is generated here and prepended to the routine's own
# prompt, which carries the packet. The routine file is frozen ground while
# #794 lands, and #794 is moving this prose into the runner anyway, so the
# lister composes rather than edits.
lister_header() {
  cat <<'HEADER'
This call is not the review. Record no verdict and judge nothing: do not say
whether the diff meets anything, and do not comment on its quality.

List what this diff must do and what it must avoid — the requirements the
ticket, its parent plan, and the repository's stated rules place on it. One
checkable claim per entry, in the words of the ticket or the plan wherever it
states one. Every later judge reads this list and nothing else, so a
requirement missing here is never checked, and a vague one cannot be answered.

Answer with exactly one JSON object and nothing else:

{"requirements": ["the first requirement", "the second requirement"]}

The text after this paragraph is the review question, included for the packet
it carries. Read its packet; ignore its instructions about verdicts and about
the shape of your answer, which this paragraph replaces.
HEADER
}

# Validate the lister's answer and keep the list. Exit 3 on every malformed
# shape, which is the retryable status review-apply already uses, so the one
# retry below reads the same way as the judging retry.
parse_requirements() {
  python3 - "$ANSWER_FILE" "$REQUIREMENTS_FILE" <<'PY'
import json
import sys

answer_path, out_path = sys.argv[1], sys.argv[2]


def malformed(reason):
    sys.stderr.write(reason + "\n")
    raise SystemExit(3)


raw = open(answer_path).read()
if not raw.strip():
    malformed("empty answer: expected a JSON object")
try:
    answer = json.loads(raw)
except ValueError as exc:
    malformed("invalid JSON: {}".format(exc))
if not isinstance(answer, dict):
    malformed("answer must be a JSON object, got {}".format(
        type(answer).__name__))
if "requirements" not in answer:
    malformed("missing required key 'requirements'")
values = answer["requirements"]
if not isinstance(values, list):
    malformed("'requirements' must be a list, got {}".format(
        type(values).__name__))
requirements = []
for index, value in enumerate(values):
    if not isinstance(value, str):
        malformed("'requirements'[{}] must be a string, got {}".format(
            index, type(value).__name__))
    text = value.strip()
    if not text:
        malformed("'requirements'[{}] must not be blank".format(index))
    requirements.append(text)
if not requirements:
    # Fail rather than proceed. An empty list is not "nothing to object to":
    # under #1242 every judge would have nothing to answer and the derived
    # verdict would be an approval nobody checked.
    malformed("'requirements' must name at least one requirement")
with open(out_path, "w") as handle:
    json.dump(requirements, handle, indent=2)
PY
}

# The lister call and its one retry. Returns non-zero only after the run has
# been finished as errored: no verdict is recorded, so the PR stays in the
# review queue for the next run rather than being rejected for the model's
# formatting.
list_requirements() {
  local attempt=1
  local parse_err
  local muse_status
  local parse_status
  printf '%s\n\n%s' "$(lister_header)" "$PROMPT" >"$PROMPT_FILE"
  while true; do
    call_model
    muse_status=$?
    if (( muse_status != 0 )); then
      model_failed "$muse_status"
    fi
    # Read the status directly, for the same reason the judging loop does:
    # `$?` inside an `if !` branch is the negated condition's status.
    parse_requirements 2>"$DIAG_FILE"
    parse_status=$?
    if (( parse_status == 0 )); then
      return 0
    fi
    parse_err="$(cat "$DIAG_FILE")"
    if (( attempt == 1 )); then
      printf '%s\n\n%s\n\nYour previous answer could not be parsed: %s\nReply again with exactly one JSON object and nothing else.' \
        "$(lister_header)" "$PROMPT" "$parse_err" >"$PROMPT_FILE"
      attempt=2
      continue
    fi
    echo "muse-review-engine: the requirement list could not be parsed: $parse_err" >&2
    failure "could not list the requirements for PR #$BEGIN_PR in $BEGIN_REPO: $parse_err" || true
    return 1
  done
}

if ! list_requirements; then
  exit 1
fi

# Split the canonical list before any judge starts. The helper owns the
# three-item bound; every call below receives exactly one of these slices.
if ! python3 - "$REPO" "$REQUIREMENTS_FILE" "$CHUNKS_FILE" \
    >"$DIAG_FILE" 2>&1 <<'PY'
import json
import os
import sys

sys.path.insert(0, sys.argv[1])
from engine.review import ReviewJudgeError, chunk_requirements

requirements = json.load(open(sys.argv[2]))
try:
    chunks = chunk_requirements(requirements)
except ReviewJudgeError as exc:
    print(str(exc), file=sys.stderr)
    raise SystemExit(1)
if not chunks:
    print("the requirement list is empty", file=sys.stderr)
    raise SystemExit(1)
with open(sys.argv[3], "w") as handle:
    json.dump(chunks, handle, indent=2)
PY
then
  chunk_err="$(cat "$DIAG_FILE")"
  echo "muse-review-engine: could not split the requirement list: $chunk_err" >&2
  failure "could not split requirements for PR #$BEGIN_PR in $BEGIN_REPO: $chunk_err" || true
  exit 1
fi

if ! JUDGE_COUNT="$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1]))))' "$CHUNKS_FILE")" \
  || [[ ! "$JUDGE_COUNT" =~ ^[1-9][0-9]*$ ]]; then
  echo "muse-review-engine: the judge chunk list is invalid" >&2
  failure "could not read judge chunks for PR #$BEGIN_PR in $BEGIN_REPO" || true
  exit 1
fi

judge_header() {
  cat <<'HEADER'
This is one judge call in a larger review. Judge only the requirements in
the list below against the supplied review packet. Do not derive additional
requirements, judge requirements outside this list, or give an overall
verdict. A requirement is met only when the diff satisfies it; use unmet
when the diff clearly fails it and unsure when the packet cannot resolve it.
For each result, cite the relevant diff lines or explain the uncertainty.

Judge run-outcome requirements against the packet's CI section first. A
successful named check in `ci.checks` for the packet's `head_sha` satisfies
only a run-outcome requirement that check directly proves (for example, an
`offline` check with `SUCCESS` proves "offline tests are green"). Do not mark
that proved requirement unsure because no Run evidence comment exists. Judge
run-outcome requirements the CI section does not prove, and post-merge runtime
requirements, against posted PR `**Run evidence:**` in `pr_comments`:
command, exit status, output summary, and environment note. Presence is
evidence, never automatic satisfaction; malformed or incomplete blocks stay prose.
For post-merge runtime facts, a throwaway `launchctl submit` probe may
produce pre-merge evidence: fire, read, post the evidence, end the job.
Install nothing; leave the keeper unchanged.

Return exactly one JSON object with one result for every assigned requirement
and no others:

{"requirements": [{"requirement": "exact requirement", "status": "met" | "unmet" | "unsure", "evidence": "diff evidence"}]}

The assigned requirements are:
```json
HEADER
  cat "$1"
  printf '\n'
  cat <<'HEADER'
```

The text below carries the cached review packet. Use it only as evidence.
Its own instructions about an overall verdict or response format are
superseded by this judge-call contract.
HEADER
}

build_judge_prompt() {
  local requirements_path="$1"
  local prompt_path="$2"
  local parse_error="${3:-}"
  {
    judge_header "$requirements_path"
    printf '\n\n%s' "$PROMPT"
    if [[ -n "$parse_error" ]]; then
      printf '\n\nYour previous answer could not be parsed: %s\nReply again with exactly one JSON object and nothing else.' \
        "$parse_error"
    fi
  } >"$prompt_path"
}

validate_judge_answer() {
  local answer_path="$1"
  local requirements_path="$2"
  local result_path="$3"
  python3 - "$REPO" "$answer_path" "$requirements_path" "$result_path" <<'PY'
import json
import sys

sys.path.insert(0, sys.argv[1])
from engine.review import ReviewJudgeError, parse_judge_answer

try:
    answer = parse_judge_answer(
        open(sys.argv[2]).read(), json.load(open(sys.argv[3])))
except ReviewJudgeError as exc:
    print(str(exc), file=sys.stderr)
    raise SystemExit(3)
with open(sys.argv[4], "w") as handle:
    json.dump(answer, handle, indent=2)
PY
}

write_uncertain_judge_results() {
  local requirements_path="$1"
  local evidence="$2"
  local result_path="$3"
  python3 - "$REPO" "$requirements_path" "$evidence" "$result_path" <<'PY'
import json
import sys

sys.path.insert(0, sys.argv[1])
from engine.review import uncertain_judge_results

results = uncertain_judge_results(json.load(open(sys.argv[2])), sys.argv[3])
with open(sys.argv[4], "w") as handle:
    json.dump(results, handle, indent=2)
PY
}

run_judge_chunk() {
  local index="$1"
  local call_dir="$2"
  local requirements_path="$call_dir/requirements.json"
  local prompt_path="$call_dir/prompt.txt"
  local answer_path="$call_dir/answer.json"
  local diag_path="$call_dir/diag.txt"
  local result_path="$call_dir/result.json"
  local parse_diag="$call_dir/parse.txt"
  local attempt=1
  local muse_status
  local parse_status
  local parse_err
  local evidence

  build_judge_prompt "$requirements_path" "$prompt_path"
  while true; do
    call_model_files "$prompt_path" "$answer_path" "$diag_path"
    muse_status=$?
    if (( muse_status != 0 )); then
      # A spent z.ai window is not an answer about these requirements, so it
      # must not become `unsure` and, through it, a rejection of a PR nobody
      # judged. Leave the marker and no result; the loop below finishes the
      # whole run as a quota skip and applies no verdict (#1411).
      if [[ "$BACKEND" == "zai" ]] && (( muse_status == ZAI_QUOTA_EXIT )); then
        cp "$diag_path" "$call_dir/quota" 2>/dev/null || : > "$call_dir/quota"
        echo "muse-review-engine: judge chunk $index met a spent z.ai window" >&2
        return 0
      fi
      if (( muse_status == 124 )); then
        evidence="judge call timed out after ${BOUND_SECONDS} seconds"
      else
        diagnostic="$(head -c 1000 "$diag_path" 2>/dev/null || true)"
        evidence="judge call failed (exit $muse_status)"
        if [[ -n "$diagnostic" ]]; then
          evidence="$evidence: $diagnostic"
        fi
      fi
      echo "muse-review-engine: judge chunk $index failed closed: $evidence" >&2
      if ! write_uncertain_judge_results \
          "$requirements_path" "$evidence" "$result_path" \
          2>"$parse_diag"; then
        echo "muse-review-engine: could not record failed judge chunk $index" >&2
        return 1
      fi
      return 0
    fi

    validate_judge_answer "$answer_path" "$requirements_path" \
      "$result_path" 2>"$parse_diag"
    parse_status=$?
    if (( parse_status == 0 )); then
      return 0
    fi
    parse_err="$(cat "$parse_diag")"
    if (( attempt == 1 )); then
      build_judge_prompt "$requirements_path" "$prompt_path" "$parse_err"
      attempt=2
      continue
    fi

    evidence="judge answer could not be parsed after two attempts: $parse_err"
    echo "muse-review-engine: judge chunk $index failed closed: $evidence" >&2
    if ! write_uncertain_judge_results \
        "$requirements_path" "$evidence" "$result_path" \
        2>"$parse_diag"; then
      echo "muse-review-engine: could not record invalid judge chunk $index" >&2
      return 1
    fi
    return 0
  done
}

# Build one private call directory per slice, then start all judges together.
# Their inputs are independent and each file is isolated, so parallel max
# calls do not race over the cached packet, answer, or diagnostic.
#
# On z.ai, one at a time instead (#1411). The Lite plan refuses concurrent
# requests (code 1302), and a GLM-5.3 answer takes minutes, so parallel judges
# past the limit would wait out their retries and read `unsure` — a rejection
# of a good PR on every review with more than one chunk. Sequential judges
# also stop at the first spent window instead of spending the rest of the
# chunks' credits on a run that cannot record a verdict. Muse is unchanged.
JUDGE_PIDS=()
JUDGE_RUN_STATUS=0
for (( index = 0; index < JUDGE_COUNT; index++ )); do
  CALL_DIR="$RUN_DIR/judge.$index"
  if ! mkdir "$CALL_DIR"; then
    echo "muse-review-engine: could not create judge chunk $index directory" >&2
    failure "could not create judge chunk $index for PR #$BEGIN_PR in $BEGIN_REPO" || true
    exit 1
  fi
  if ! python3 - "$CHUNKS_FILE" "$index" "$CALL_DIR/requirements.json" \
      >"$CALL_DIR/setup.txt" 2>&1 <<'PY'
import json
import sys

chunks = json.load(open(sys.argv[1]))
chunk = chunks[int(sys.argv[2])]
with open(sys.argv[3], "w") as handle:
    json.dump(chunk, handle, indent=2)
PY
  then
    chunk_err="$(cat "$CALL_DIR/setup.txt")"
    echo "muse-review-engine: could not prepare judge chunk $index: $chunk_err" >&2
    failure "could not prepare judge chunk $index for PR #$BEGIN_PR in $BEGIN_REPO" || true
    exit 1
  fi
  if [[ "$BACKEND" == "zai" ]]; then
    run_judge_chunk "$index" "$CALL_DIR"
    judge_status=$?
    if (( judge_status != 0 )); then
      JUDGE_RUN_STATUS=1
    fi
    if [[ -e "$CALL_DIR/quota" ]]; then
      zai_quota_skip "$CALL_DIR/quota" "$ZAI_QUOTA_EXIT"
    fi
  else
    run_judge_chunk "$index" "$CALL_DIR" &
    JUDGE_PIDS+=("$!")
  fi
done
# The `+` guard: bash 3.2, which launchd's /bin/bash is, reads an empty
# array under `set -u` as unbound, and the z.ai path leaves this one empty.
for judge_pid in ${JUDGE_PIDS[@]+"${JUDGE_PIDS[@]}"}; do
  wait "$judge_pid"
  judge_status=$?
  if (( judge_status != 0 )); then
    JUDGE_RUN_STATUS=1
  fi
done
if (( JUDGE_RUN_STATUS != 0 )); then
  failure "could not record one or more judge results for PR #$BEGIN_PR in $BEGIN_REPO" || true
  exit 1
fi

# Preserve the shared provider-quota hold when a failed judge captured its
# refusal. The failed chunk still becomes unsure and the code-derived verdict
# remains rejected, as the ticket requires. Muse only: a judge that met a
# spent z.ai window has already ended the run as a quota skip above, and the
# next `begin` reads the window from z.ai, so there is no hold to write — and
# a Muse-shaped refusal in a z.ai judge's diagnostic must never park Muse.
if [[ "$BACKEND" == "muse" ]]; then
  for (( index = 0; index < JUDGE_COUNT; index++ )); do
    if MUSE_QUOTA_RESET="$(muse_quota_record "$RUN_DIR/judge.$index/diag.txt" "${BEGIN_RUN:-}")"; then
      echo "muse-review-engine: Muse's provider quota is exhausted; parking future lanes until $MUSE_QUOTA_RESET" >&2
      break
    fi
  done
fi

# Flatten chunks in canonical order and derive the only answer passed to
# review-apply. A missing/corrupt result file is expanded to unsure entries;
# no requirement can disappear into an incomplete parallel response.
if ! python3 - "$REPO" "$REQUIREMENTS_FILE" "$CHUNKS_FILE" \
    "$RUN_DIR" "$JUDGE_COUNT" "$ANSWER_FILE" >"$DIAG_FILE" 2>&1 <<'PY'
import json
import os
import sys

sys.path.insert(0, sys.argv[1])
from engine.review import derive_judge_answer, uncertain_judge_results

requirements = json.load(open(sys.argv[2]))
chunks = json.load(open(sys.argv[3]))
run_dir = sys.argv[4]
chunk_count = int(sys.argv[5])
results = []
for index in range(chunk_count):
    chunk = chunks[index]
    result_path = os.path.join(run_dir, "judge.{}".format(index),
                               "result.json")
    try:
        chunk_results = json.load(open(result_path))
        if not isinstance(chunk_results, list):
            raise ValueError("result is not a list")
    except (OSError, ValueError) as exc:
        chunk_results = uncertain_judge_results(
            chunk, "No valid result was recorded for this judge call: {}"
            .format(exc))
    results.extend(chunk_results)
answer = derive_judge_answer(requirements, results)
with open(sys.argv[6], "w") as handle:
    json.dump(answer, handle, indent=2)
PY
then
  derive_err="$(cat "$DIAG_FILE")"
  echo "muse-review-engine: could not derive the review verdict: $derive_err" >&2
  failure "could not derive the review verdict for PR #$BEGIN_PR in $BEGIN_REPO" || true
  exit 1
fi

# The recorded verdict word, read back from review-apply's own report — never
# trusted from a model answer. The runner has already derived it from every
# canonical requirement; review-apply independently fails closed as well.
recorded_verdict() {
  grep -o 'recorded \(approved\|rejected\)' "$DIAG_FILE" | tail -n 1 | awk '{print $2}'
}

ATTEMPT=1
while true; do
  # The answer is code-generated, so a retryable apply validation failure is
  # retried against the same derived object, never by asking a model for an
  # overall verdict.
  python3 "$REPO/review-apply" "$BEGIN_PR" --repo "$BEGIN_REPO" \
      --answer "$ANSWER_FILE" --ci "$PACKET_CI" --head "$PACKET_HEAD" \
      --attempt "$ATTEMPT" --run "$BEGIN_RUN" --agent "$AGENT" \
      >"$DIAG_FILE" 2>&1
  apply_status=$?
  if (( apply_status == 0 )); then
    if grep -qx 'run outcome: skipped-locked' "$DIAG_FILE"; then
      skip_note="$(grep '^review-apply: ' "$DIAG_FILE" | tail -n 1 | sed 's/^review-apply: //')"
      if [[ -z "$skip_note" ]]; then
        echo "muse-review-engine: skipped-locked apply omitted its finish note" >&2
        failure "review-apply reported skipped-locked without a finish note on PR #$BEGIN_PR in $BEGIN_REPO" || true
        exit 1
      fi
      finish_skipped_locked "$skip_note"
      exit 0
    fi
    VERDICT="$(recorded_verdict)"
    if [[ -z "$VERDICT" ]]; then
      VERDICT="recorded"
    fi
    ALREADY_MERGED="$(grep -F 'review-apply: observed already-merged PR: ' \
      "$DIAG_FILE" | tail -n 1 || true)"
    if [[ -n "$ALREADY_MERGED" ]]; then
      MERGE_DETAIL="${ALREADY_MERGED#review-apply: }"
      finish_done "reviewed PR #$BEGIN_PR in $BEGIN_REPO at $HEAD_SHORT: $VERDICT; $MERGE_DETAIL" \
        "$VERDICT" "" "$BEGIN_PR"
    else
      finish_done "reviewed PR #$BEGIN_PR in $BEGIN_REPO at $HEAD_SHORT: $VERDICT" "$VERDICT"
    fi
    exit 0
  fi
  if (( apply_status == 3 && ATTEMPT == 1 )); then
    ATTEMPT=2
    continue
  fi
  apply_err="$(cat "$DIAG_FILE")"
  if printf '%s' "$apply_err" | grep -q 'run outcome: errored'; then
    echo "muse-review-engine: the final answer was malformed; rejected was recorded" >&2
    failure "recorded rejected on PR #$BEGIN_PR in $BEGIN_REPO after a malformed final answer" || true
    exit 1
  fi
  echo "muse-review-engine: review-apply failed: $apply_err" >&2
  failure "review-apply failed on PR #$BEGIN_PR in $BEGIN_REPO: $apply_err" || true
  exit 1
done

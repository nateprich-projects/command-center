<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The shadow reviewer: one escalated Muse review run that records its judgement
  but applies nothing.

  This schedule runs beside the old routine, now the escalated reviewer, during
  the shadow period required before the #794 cutover. The engine records its
  answer on the PR and in the finish note; the live review path remains
  unchanged.

  It shadowed the standard tier until 2026-09-20, when that tier cut over to
  the engine (#813, and the standard half of #806). The escalated tier was
  never shadowed, so it has no evidence of its own; Nate's decision in session
  was to ship the measured tier and measure the unmeasured one. It runs at
  `max` effort, the same as the live escalated reviewer it is measured
  against, so the agreement rate compares the engine rather than the effort
  level. `max` is also the engine's own default (#976).

  The canonical copy lives here in the repo. launchd refuses a symlinked plist
  (`Bootstrap failed: 5: Input/output error`, measured 2026-09-07), so the
  installed file is a copy and `tests/test_launchd_drift.py` compares them.

  `/bin/bash <script>`, not the script directly: this repository used to live
  on an external volume that a launchd job could not read at all. It now lives
  on the internal disk, but invoking through bash costs nothing and survives a
  move.

  Note for editors: XML forbids a double hyphen inside a comment. Use an em dash
  or a semicolon; plutil accepts the double hyphen and plistlib rejects it, so a
  file can lint clean and still be unparseable.

  After editing, re-install:
    cp launchd/com.nateprich.command-center-muse-review-shadow.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.nateprich.command-center-muse-review-shadow
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nateprich.command-center-muse-review-shadow.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nateprich.command-center-muse-review-shadow</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nateprich/.claude/command-center-run/scripts/muse-review-engine</string>
        <string>--shadow</string>
        <string>escalated</string>
        <string>max</string>
    </array>

    <!--
      Every fifteen minutes on a fixed interval, identical to the escalated
      review routine it now shadows (#859 put that tier on `StartInterval`
      while #794's escalated tickets clear). Running beside the old routine
      gives the engine a shadow record for every escalated review slot without
      changing the live review path.

      Was a five-minute calendar schedule, matching the standard reviewer, until
      that tier cut over to the engine on 2026-09-20.
    -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/nateprich/Library/Logs/command-center-muse-review-shadow.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nateprich/Library/Logs/command-center-muse-review-shadow.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/nateprich/.local/bin</string>
        <key>HOME</key>
        <string>/Users/nateprich</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

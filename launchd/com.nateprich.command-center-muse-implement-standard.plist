<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The standard Muse implementer: one ticket per run, then stop.

  Added 2026-09-18 by Nate's instruction, when Codex's weekly usage was nearly
  spent and Muse had ample headroom: Muse took over the standard lane Codex ran.
  It is its own job, beside the escalated one, so the two tiers never queue
  behind each other; launchd starts no second instance of either while it runs.

  The canonical copy lives here in the repo. launchd refuses a symlinked plist
  (Bootstrap failed: 5: Input/output error, measured 2026-09-07), so the
  installed file is a copy and tests/test_launchd_drift.py compares them.

  /bin/bash <script>, not the script directly: this repository used to live on
  an external volume that a launchd job could not read at all. It now lives on
  the internal disk, but invoking through bash costs nothing and survives a move.

  Note for editors: XML forbids a double hyphen inside a comment. Use an em dash
  or a semicolon; plutil accepts the double hyphen and plistlib rejects it, so a
  file can lint clean and still be unparseable.

  After editing, re-install:
    cp launchd/com.nateprich.command-center-muse-implement-standard.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.nateprich.command-center-muse-implement-standard
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nateprich.command-center-muse-implement-standard.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nateprich.command-center-muse-implement-standard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nateprich/.claude/command-center-run/scripts/muse-implement</string>
        <string>standard</string>
        <string>max</string>
    </array>

    <!--
      Every 10 minutes, the cadence of the Codex automation this lane replaces.
      An empty fire is one begin call.
    -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/nateprich/Library/Logs/command-center-muse-implement-standard.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nateprich/Library/Logs/command-center-muse-implement-standard.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/nateprich/.local/bin</string>
        <key>HOME</key>
        <string>/Users/nateprich</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

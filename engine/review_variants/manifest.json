{
  "schema_version": 1,
  "active_variant": "baseline",
  "trial_enabled": false,
  "trial_definition": {
    "scope": "reviewer-only",
    "duration_days": 14,
    "max_rounds": 2,
    "max_variants_including_baselines": 5
  },
  "rounds": [
    {
      "name": "round-1",
      "variants": ["baseline", "r1", "r2", "r4"]
    },
    {
      "name": "round-2",
      "variants": ["baseline", "best_round_1_single"]
    }
  ],
  "round_2_selection": {
    "variant": "best_round_1_single",
    "candidates": ["r1", "r2", "r4"],
    "max_selected": 1,
    "evaluation": {
      "method": "paired-a+b",
      "packet_version": "v1",
      "packets": ["must_reject", "must_approve"],
      "sequential": {
        "initial_runs_per_side": 40,
        "additional_runs_per_side": 20,
        "max_runs_per_side": 120,
        "stop_for_decline_fisher_p_below": 0.05,
        "stop_for_futility_fisher_p_above": 0.3
      },
      "margins": {
        "must_reject_drop": 0.15,
        "must_approve_false_block_rise": 0.1,
        "joint_detection_lift": 0.1,
        "joint_false_block_change": 0.05
      },
      "intervals": {
        "rate_difference": "newcombe-wilson-95",
        "paired_rates": "wilson-95"
      },
      "interpretation": {
        "fisher_p_value": "sample_size_only",
        "inconclusive_is_pass": false,
        "merge_blocking": false
      }
    }
  },
  "restore": {
    "variant": "baseline",
    "runs": 3,
    "replays": [
      {"name": "must-reject", "expected": "rejected"},
      {"name": "must-approve", "expected": "approved"}
    ]
  },
  "variant_files": {
    "baseline": "baseline.json",
    "r1": "r1.json",
    "r2": "r2.json",
    "r4": "r4.json"
  }
}

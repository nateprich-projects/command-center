#!/bin/bash
# Refresh the maintained checkout, install changed prompts and plists, and
# append one machine-health line plus one keeper-readiness line.
#
# It never starts an agent and never writes the checkout used by the routines:
# installs go to the Codex automations and the user's LaunchAgents, and both
# records are committed to the existing orphan `heartbeat` branch through a
# temporary worktree, so the maintained checkout stays on `main` for the next
# run.
#
# Every run also loads any installed plist whose label launchd does not have
# (#1196). To pause a lane on purpose, move its plist out of LaunchAgents: an
# installed plist with no loaded label is read as a failed reload and healed.
#
# The Codex prompt derivation lives here, in keeper_prompts below: this script
# is the only writer of the installed automations, and the only reader of them
# outside the Codex app. Nothing in the pytest suite touches them.

set -u

REPO="${COMMAND_CENTER_RUN_REPO:-/Users/nateprich/.claude/command-center-run}"
REMOTE="${COMMAND_CENTER_SENTINEL_REMOTE:-origin}"
SENTINEL_FILE="${COMMAND_CENTER_SENTINEL_FILE:-sentinel.log}"
GIT="${COMMAND_CENTER_SENTINEL_GIT:-/usr/bin/git}"
PS="${COMMAND_CENTER_SENTINEL_PS:-/bin/ps}"
PGREP="${COMMAND_CENTER_SENTINEL_PGREP:-/usr/bin/pgrep}"
SYSCTL="${COMMAND_CENTER_SENTINEL_SYSCTL:-/usr/sbin/sysctl}"
UPTIME="${COMMAND_CENTER_SENTINEL_UPTIME:-/usr/bin/uptime}"
READINESS_FILE="${COMMAND_CENTER_KEEPER_READINESS_FILE:-keeper-readiness.log}"
LAUNCHCTL="${COMMAND_CENTER_KEEPER_LAUNCHCTL:-/bin/launchctl}"
# A booted-out label takes a moment to leave launchd, longer when a run was in
# flight, and a bootstrap issued before it has gone fails with an input/output
# error (#1196).  Wait for it, bounded, and retry a bootstrap that still fails.
RELOAD_WAIT_TRIES="${COMMAND_CENTER_KEEPER_RELOAD_WAIT_TRIES:-30}"
RELOAD_WAIT_SECONDS="${COMMAND_CENTER_KEEPER_RELOAD_WAIT_SECONDS:-1}"
BOOTSTRAP_TRIES="${COMMAND_CENTER_KEEPER_BOOTSTRAP_TRIES:-3}"
BOOTSTRAP_RETRY_SECONDS="${COMMAND_CENTER_KEEPER_BOOTSTRAP_RETRY_SECONDS:-5}"

KEEPER_LABEL="com.nateprich.command-center-run-keeper"
ROUTINE_PATH="routines/codex-work.md"
LAUNCH_AGENTS_DIR="${HOME:-}/Library/LaunchAgents"

# Keep the existing keeper responsibility.  A failed refresh must not suppress
# the health or readiness lines: the keeper is meant to remain useful during
# degradation.  The pre-pull HEAD is the install trigger: prompts and plists
# install only when the pull moved their source, while readiness is compared
# every run, so drift without a pull change is reported rather than silently
# kept.
before_sha="$("$GIT" -C "$REPO" rev-parse HEAD 2>/dev/null || true)"
# Fetch the one branch explicitly and fast-forward from the remote-tracking
# ref. A bare `git pull --ff-only` merges FETCH_HEAD, and a heartbeat run
# fetching its own branch in this clone at the same moment leaves two entries
# there: "fatal: Cannot fast-forward to multiple branches", which left the run
# clone three commits behind for three hours on 2026-09-15 (#902). Naming the
# ref makes the update immune to that race.
"$GIT" -C "$REPO" fetch --quiet origin "+refs/heads/main:refs/remotes/origin/main" || true
"$GIT" -C "$REPO" merge --ff-only origin/main >/dev/null 2>&1 || true
after_sha="$("$GIT" -C "$REPO" rev-parse HEAD 2>/dev/null || true)"
pulled_changes=""
if [ -n "$before_sha" ] && [ -n "$after_sha" ] && [ "$before_sha" != "$after_sha" ]; then
  pulled_changes=$("$GIT" -C "$REPO" diff --name-only "$before_sha" "$after_sha" 2>/dev/null || true)
fi

trim_spaces() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

csv_add() {
  if [ -z "$1" ]; then
    printf '%s' "$2"
  else
    printf '%s,%s' "$1" "$2"
  fi
}

timestamp="$("$PS" -p "$$" -o lstart= 2>/dev/null || true)"
timestamp="$(trim_spaces "$timestamp")"
timestamp="${timestamp// /_}"
[ -n "$timestamp" ] || timestamp="unknown"

maxprocperuid="$("$SYSCTL" -n kern.maxprocperuid 2>/dev/null || true)"
maxprocperuid="$(trim_spaces "$maxprocperuid")"
[ -n "$maxprocperuid" ] || maxprocperuid="unknown"

uid="$("$PS" -p "$$" -o uid= 2>/dev/null || true)"
uid="$(trim_spaces "$uid")"
process_table="$("$PS" -A -o uid= 2>/dev/null || true)"
if [ -n "$uid" ] && [ -n "$process_table" ]; then
  user_processes=0
  while IFS= read -r process_uid; do
    process_uid="${process_uid//[[:space:]]/}"
    [ "$process_uid" = "$uid" ] && user_processes=$((user_processes + 1))
  done <<< "$process_table"
else
  user_processes="unknown"
fi

uptime_line="$("$UPTIME" 2>/dev/null || true)"
load_1="unknown"
load_5="unknown"
load_15="unknown"
case "$uptime_line" in
  *"load averages:"*)
    loads="${uptime_line#*load averages:}"
    loads="$(trim_spaces "$loads")"
    read -r load_1 load_5 load_15 _ <<< "$loads"
    ;;
esac
[ -n "$load_1" ] || load_1="unknown"
[ -n "$load_5" ] || load_5="unknown"
[ -n "$load_15" ] || load_15="unknown"

has_process_family() {
  if "$PGREP" -if "$1" >/dev/null 2>&1; then
    printf '1'
  else
    printf '0'
  fi
}

health_line="timestamp=$timestamp user_processes=$user_processes maxprocperuid=$maxprocperuid load_1=$load_1 load_5=$load_5 load_15=$load_15 codex=$(has_process_family codex) claude=$(has_process_family claude) muse=$(has_process_family muse)"

# The installed Codex prompt for one automation, compared or written.
# `keeper_prompts check` prints one `  DRIFTED  <name>` line per stale
# automation and exits 1 when any drifted; `keeper_prompts install` writes
# every stale prompt (leaving a `.bak` beside it) and exits 1 when stale
# prompts remain. Only the `prompt` field is touched; schedule, model and
# everything else stay exactly as the app wrote them.
keeper_prompts() {
  KEEPER_ROUTINE="$REPO/$ROUTINE_PATH" \
  KEEPER_AUTOMATIONS="${HOME:-}/.codex/automations" \
  PYTHONDONTWRITEBYTECODE=1 python3 - "$1" <<'PY'
import datetime
import hashlib
import json
import os
import pathlib
import re
import shutil
import sys
import time

ROUTINE = pathlib.Path(os.environ["KEEPER_ROUTINE"])
AUTOMATIONS = pathlib.Path(os.environ["KEEPER_AUTOMATIONS"])
GLOB = "command-center-*/automation.toml"

#: Everything above this line in the routine is setup documentation for Nate;
#: below it is what the agent runs.
SEPARATOR = "\n---\n"
BEGIN_LINE = "funnel.py begin --agent codex --tier standard"
#: A schedule with `BYHOUR` fires only in chosen windows; one without it
#: fires all day. That one fact decides both which tier a lane works and
#: whether it pays the presence proxy — read separately for each, so a change
#: to one can never silently move the other (2026-09-07).
IDLE_RRULE_MARKER = "BYHOUR="


def fires_all_day(automation):
    """True when the clock cannot vouch for Nate being away. Unknown
    schedules default to True: refusing to compete with him is the safe
    direction, assuming he is out is not."""
    if not automation:
        return False
    path = AUTOMATIONS / automation / "automation.toml"
    try:
        rule = re.search(r'^rrule = "(.*)"$', path.read_text(), re.MULTILINE)
    except OSError:
        return True
    if not rule:
        return True
    return IDLE_RRULE_MARKER not in rule.group(1)


def prompt_text(automation=""):
    """The runtime prompt for one automation: title plus runtime, with the
    tier and idle flag derived from when the schedule fires."""
    body = ROUTINE.read_text()
    title = body.splitlines()[0].strip()
    if SEPARATOR not in body:
        raise SystemExit(
            "no '---' separator; cannot tell setup notes from the runtime prompt"
        )
    runtime = body.split(SEPARATOR, 1)[1].strip()
    tier = "standard" if fires_all_day(automation) else "escalated"
    begin = BEGIN_LINE.replace("standard", tier)
    if fires_all_day(automation):
        begin += " --idle"
    runtime = runtime.replace(BEGIN_LINE, begin, 1)
    return "{}\n\n{}\n".format(title, runtime)


def same_prompt(existing, wanted):
    """Whether a stored prompt matches, ignoring the trailing newline the
    Codex app strips when it saves an automation. Only trailing whitespace
    is forgiven; any other difference is drift."""
    if existing is None:
        return False
    return existing.rstrip("\n") == wanted.rstrip("\n")


def current(text):
    match = re.search(r'^prompt = (".*")$', text, re.MULTILINE)
    if not match:
        return None, None
    return match.group(1), json.loads(match.group(1))


def main(mode):
    files = sorted(AUTOMATIONS.glob(GLOB))
    if not files:
        print(
            "no Command Center automations found under {}".format(AUTOMATIONS),
            file=sys.stderr,
        )
        return 1

    drifted = []
    ledger = []
    stale = []
    for path in files:
        name = path.parent.name
        wanted = prompt_text(name)
        try:
            text = path.read_text()
        except OSError as exc:
            if mode == "check":
                raise
            print("{}: unreadable — {}".format(name, exc), file=sys.stderr)
            ledger.append((name, "unwritable"))
            stale.append(name)
            continue
        raw, existing = current(text)
        if raw is None:
            print("{}: no prompt field — skipped".format(name), file=sys.stderr)
            if mode != "check":
                ledger.append((name, "unwritable"))
                stale.append(name)
            continue
        if same_prompt(existing, wanted):
            print("  ok       {}".format(name))
            if mode != "check":
                ledger.append((name, "already current"))
            continue
        drifted.append(name)
        if mode == "check":
            # Record *when* it changed, not only that it did: a mismatch
            # alone cannot tell a file someone rewrote from an expected
            # value that moved underneath it.
            stat = path.stat()
            print("  DRIFTED  {}".format(name))
            print("           file written {}  ({} bytes, sha {})".format(
                datetime.datetime.fromtimestamp(stat.st_mtime).isoformat(
                    timespec="seconds"),
                stat.st_size,
                hashlib.sha256(path.read_bytes()).hexdigest()[:12]))
            print("           routine written {}  (expected prompt sha {})".format(
                datetime.datetime.fromtimestamp(
                    ROUTINE.stat().st_mtime).isoformat(timespec="seconds"),
                hashlib.sha256(wanted.encode()).hexdigest()[:12]))
            first = next((i for i, (a, b) in enumerate(
                zip((existing or "").splitlines(), wanted.splitlines()))
                if a != b), None)
            if first is not None:
                print("           first differing line {}:".format(first + 1))
                print("             stored:   {}".format(
                    (existing or "").splitlines()[first][:88]))
                print("             expected: {}".format(
                    wanted.splitlines()[first][:88]))
            continue

        try:
            shutil.copy2(path, path.with_suffix(".toml.bak"))
            text = text.replace(raw, json.dumps(wanted), 1)
            text = re.sub(r"^updated_at = \d+$",
                          "updated_at = {}".format(int(time.time() * 1000)),
                          text, count=1, flags=re.MULTILINE)
            path.write_text(text)

            _, written = current(path.read_text())
            if written != wanted:
                raise SystemExit("{}: wrote the prompt but it did not read back "
                                 "identically — restore from the .bak".format(path))
        except OSError as exc:
            print("{}: unwritable — {}".format(name, exc), file=sys.stderr)
            ledger.append((name, "unwritable"))
            stale.append(name)
            continue
        ledger.append((name, "updated"))
        print("  updated  {}".format(name))

    if mode != "check":
        print("\nSync summary:")
        for name, outcome in ledger:
            print("  {:16} {}".format(outcome, name))
        if stale:
            print("\nStale prompts remain:")
            for name in stale:
                print("  {}".format(name))
            return 1
    elif drifted:
        print("\n{} of {} automations have drifted".format(
            len(drifted), len(files)))
        return 1
    return 0


sys.exit(main(sys.argv[1]))
PY
}

# Phase 4 (#794): install on change.  There is deliberately no quiet-moment
# condition: prompts and plists are read at run start, so a replacement
# affects only the next run (amendment accepted 2026-09-13).  An install
# failure warns on stderr and shows up in the readiness record below; it never
# suppresses either record.
label_loaded() {
  "$LAUNCHCTL" print "gui/$(id -u)/$1" >/dev/null 2>&1
}

wait_until_unloaded() {
  local label="$1" tries=0
  while [ "$tries" -lt "$RELOAD_WAIT_TRIES" ] && label_loaded "$label"; do
    tries=$((tries + 1))
    sleep "$RELOAD_WAIT_SECONDS"
  done
}

bootstrap_label() {
  local dst="$1" tries=0
  while [ "$tries" -lt "$BOOTSTRAP_TRIES" ]; do
    if "$LAUNCHCTL" bootstrap "gui/$(id -u)" "$dst" >/dev/null 2>&1; then
      return 0
    fi
    tries=$((tries + 1))
    [ "$tries" -lt "$BOOTSTRAP_TRIES" ] && sleep "$BOOTSTRAP_RETRY_SECONDS"
  done
  return 1
}

# Heal: an installed plist whose label launchd does not have is a reload that
# failed on an earlier run.  `reload_pending` describes one run's attempt and
# nothing carries it forward, so derive the owed reload from launchd instead of
# remembering it: on 2026-09-21 a failed bootstrap left the standard review
# lane unloaded for 38 minutes while every later readiness line read clean
# (#1196).  To pause a lane on purpose, move its installed plist out of
# LaunchAgents, as the retired shadow plist was; an installed plist with no
# loaded label is treated as a failure, not an intention.
heal_unloaded_labels() {
  local src name dst label
  [ -n "${HOME:-}" ] || return 0
  for src in "$REPO"/launchd/*.plist; do
    [ -f "$src" ] || continue
    name="${src##*/}"
    dst="$LAUNCH_AGENTS_DIR/$name"
    [ -f "$dst" ] || continue
    label="${name%.plist}"
    [ "$label" = "$KEEPER_LABEL" ] && continue
    case ",$reload_pending," in *",$label,"*) continue ;; esac
    label_loaded "$label" && continue
    if bootstrap_label "$dst"; then
      echo "run-keeper: loaded $label, which launchd did not have" >&2
    else
      echo "run-keeper: $label is not loaded and could not be bootstrapped" >&2
      reload_pending=$(csv_add "$reload_pending" "$label")
    fi
  done
}

install_plist() {
  local name="$1" label src dst
  name="${name##*/}"
  src="$REPO/launchd/$name"
  dst="$LAUNCH_AGENTS_DIR/$name"
  # Refresh only: the installer plus a console reload own first install, so a
  # plist that was never installed is left alone, as is one removed from the
  # repo (uninstalling a schedule is a console action, not keeper work).
  [ -n "${HOME:-}" ] || return 0
  [ -f "$src" ] || return 0
  [ -f "$dst" ] || return 0
  mkdir -p "$LAUNCH_AGENTS_DIR" 2>/dev/null || return 0
  if ! cp "$src" "$dst" 2>/dev/null; then
    echo "run-keeper: could not copy $name" >&2
    return 0
  fi
  label="${name%.plist}"
  if [ "$label" = "$KEEPER_LABEL" ]; then
    # Never bootout self mid-run.  The copy is current; a console reload (the
    # #822 human-step class) loads it.  Pending until then.
    reload_pending=$(csv_add "$reload_pending" "$label")
    return 0
  fi
  "$LAUNCHCTL" bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
  wait_until_unloaded "$label"
  if ! bootstrap_label "$dst"; then
    echo "run-keeper: reload of $label failed" >&2
    reload_pending=$(csv_add "$reload_pending" "$label")
  fi
}

reload_pending=""
routine_changed=""
while IFS= read -r changed_path; do
  [ "$changed_path" = "$ROUTINE_PATH" ] && routine_changed="yes"
  case "$changed_path" in
    launchd/*.plist) install_plist "$changed_path" ;;
  esac
done <<< "$pulled_changes"
heal_unloaded_labels
if [ -n "$routine_changed" ]; then
  keeper_prompts install || \
    echo "run-keeper: prompt install failed; see the readiness record" >&2
fi

# Readiness: installed equals main, and which files do not.  Compared every
# run whether or not this run installed anything, so the record answers
# #821's question within one keeper cycle of a deliberate edit.
prompts="yes"
plists="yes"
drifted=""
if [ -n "${HOME:-}" ]; then
  for src in "$REPO"/launchd/*.plist; do
    [ -f "$src" ] || continue
    name="${src##*/}"
    dst="$LAUNCH_AGENTS_DIR/$name"
    # Skip-if-absent, the same honesty rule as the drift tests: a plist that
    # was never installed is not evidence of drift.
    [ -f "$dst" ] || continue
    if ! cmp -s "$src" "$dst" 2>/dev/null; then
      plists="no"
      drifted=$(csv_add "$drifted" "launchd/$name")
    fi
  done
fi
# The DRIFTED lines are the comparison.
check_out=$(keeper_prompts check 2>/dev/null || true)
while IFS= read -r line; do
  case "$line" in
    "  DRIFTED  "*)
      automation="${line#*DRIFTED  }"
      automation="$(trim_spaces "$automation")"
      if [ -n "$automation" ]; then
        prompts="no"
        drifted=$(csv_add "$drifted" "codex/$automation")
      fi
      ;;
  esac
done <<< "$check_out"
[ -n "$drifted" ] || drifted="-"
[ -n "$reload_pending" ] || reload_pending="-"
readiness_line="timestamp=$timestamp prompts=$prompts plists=$plists files=$drifted reload_pending=$reload_pending"

WORKTREE="${TMPDIR:-/tmp}/command-center-sentinel.$$"

remove_worktree() {
  "$GIT" -C "$REPO" worktree remove --force "$WORKTREE" >/dev/null 2>&1 || true
}

trap remove_worktree EXIT INT TERM

push_health_line() {
  local attempt
  for attempt in 1 2 3; do
    # Refresh only the heartbeat ref.  The main checkout remains on its current
    # branch, and a failed fetch still leaves the subsequent push to fail closed.
    "$GIT" -C "$REPO" fetch "$REMOTE" heartbeat >/dev/null 2>&1 || true
    remove_worktree
    if ! "$GIT" -C "$REPO" worktree add --detach "$WORKTREE" "$REMOTE/heartbeat" >/dev/null 2>&1; then
      continue
    fi

    printf '%s\n' "$health_line" >> "$WORKTREE/$SENTINEL_FILE"
    printf '%s\n' "$readiness_line" >> "$WORKTREE/$READINESS_FILE"
    "$GIT" -C "$WORKTREE" add -- "$SENTINEL_FILE" "$READINESS_FILE" || continue
    "$GIT" -C "$WORKTREE" \
      -c user.name="Command Center sentinel" \
      -c user.email="command-center-sentinel@users.noreply.github.com" \
      commit -m "heartbeat: sentinel health and keeper readiness records" >/dev/null 2>&1 || continue

    if "$GIT" -C "$WORKTREE" push "$REMOTE" HEAD:refs/heads/heartbeat >/dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}

if ! push_health_line; then
  echo "run-keeper: could not push the health and readiness records to heartbeat" >&2
  exit 1
fi

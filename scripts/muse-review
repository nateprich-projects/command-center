#!/bin/bash
# A Muse reviewer: one run, one PR, then stop.
#
# Usage: muse-review [tier] [reasoning-effort]
#   tier   -- escalated (default) or standard; substituted into the routine
#   effort -- max (default) or high
#
# Two schedules use it: escalated hourly at max effort, standard every fifteen
# minutes at high. One script and one routine rather than two of each, because a
# second copy is a second thing to drift -- which is #52's whole subject.
#
# Invoked by launchd (com.nateprich.command-center-muse-review). Meta ships
# `muse exec` as its own documented headless mode, and Muse Code has no
# scheduler, so launchd is the sanctioned way to run this. `AGENTS.md`'s
# never-headless rule is vendor-specific to Claude Code and Codex; see the
# carve-out there before assuming this file breaks it.
#
# **The prompt is `routines/muse.md`, read at run time.** Not pasted, not
# synced, not copied. That removes the whole drift surface #52 exists for:
# there is no second copy to fall out of step with the repo.

set -uo pipefail

# launchd appends this runner's stdout to a tier-specific file. Keep the
# newest 100 MB before the runner emits anything, so the file being written is
# bounded without changing the plist or introducing a second rotation job.
# Tests may lower the byte cap without creating a 100 MB fixture.
MUSE_LOG_CAP_BYTES="${MUSE_LOG_CAP_BYTES:-104857600}"
if [[ ! "$MUSE_LOG_CAP_BYTES" =~ ^[1-9][0-9]*$ ]]; then
  MUSE_LOG_CAP_BYTES=104857600
fi
MUSE_LOG_TRIMMED=0

muse_log_size_bytes() {
  if [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]; then
    stat -f '%z' "$1"
  else
    stat -c '%s' "$1"
  fi
}

trim_muse_log() {
  local log_path="$1"
  local size_bytes
  local temp_path

  [[ -f "$log_path" ]] || return 0
  if ! size_bytes="$(muse_log_size_bytes "$log_path" 2>/dev/null)"; then
    return 0
  fi
  [[ "$size_bytes" =~ ^[0-9]+$ ]] || return 0
  (( size_bytes > MUSE_LOG_CAP_BYTES )) || return 0

  if ! temp_path="$(mktemp "${log_path}.trim.XXXXXX" 2>/dev/null)"; then
    return 0
  fi
  if ! tail -c "$MUSE_LOG_CAP_BYTES" "$log_path" >"$temp_path" 2>/dev/null; then
    rm -f "$temp_path"
    return 0
  fi
  if ! mv -f "$temp_path" "$log_path" 2>/dev/null; then
    rm -f "$temp_path"
    return 0
  fi
  MUSE_LOG_TRIMMED=1
  return 0
}

TIER="${1:-escalated}"
case "$TIER" in
  standard)
    MUSE_LOG_PATH="${MUSE_REVIEW_LOG_PATH:-${HOME:-}/Library/Logs/command-center-muse-review-standard.log}"
    ;;
  escalated)
    MUSE_LOG_PATH="${MUSE_REVIEW_LOG_PATH:-${HOME:-}/Library/Logs/command-center-muse-review.log}"
    ;;
  *)
    MUSE_LOG_PATH=""
    ;;
esac
trim_muse_log "$MUSE_LOG_PATH"
if (( MUSE_LOG_TRIMMED )); then
  exec >>"$MUSE_LOG_PATH"
fi

EFFORT="${2:-max}"
case "$TIER" in
  escalated|standard) ;;
  *) echo "muse-review: tier must be escalated or standard, got '$TIER'" >&2; exit 1 ;;
esac

# The maintained read-only clone (#171, #204), not Nate's working tree: the
# routine text and the funnel it invokes must come from the same checkout.
REPO="${MUSE_REVIEW_REPO:-/Users/nateprich/.claude/command-center-run}"
# The muse binary and the wall-clock bound are overridable for the test that
# proves the bound kills a hung run; the defaults are what launchd runs.
MUSE_BIN="${MUSE_BIN:-$HOME/.local/bin/muse}"
BOUND_SECONDS="${MUSE_REVIEW_BOUND_SECONDS:-1200}"
ROUTINE="$REPO/routines/muse.md"
# An empty directory on purpose. Muse roots its workspace at the working
# directory, so this is what it can see. Everything real is reached by absolute
# path through `gh` and `funnel.py`, read-only. Never point this at the repo:
# that is Nate's own tree with his uncommitted work in it.
WORKSPACE="$HOME/.claude/command-center-muse-workspace"

mkdir -p "$WORKSPACE" || exit 1

if [[ ! -r "$ROUTINE" ]]; then
  echo "muse-review: cannot read $ROUTINE — refusing to run without a prompt" >&2
  exit 1
fi

# Everything after the first `---` is the agent-facing prompt; the header above
# it is written for a human reading the file. Same shape as the other routines.
# Breakdown rides with the standard tier, not with escalated. It is mechanical
# work, so it belongs on the frequent cheaper-effort schedule rather than the
# hourly one at max effort -- and the escalated schedule exists so rare risky
# reviews are never left waiting, which a breakdown would delay by minutes.
FLAGS="--tier $TIER"
if [[ "$TIER" == "standard" ]]; then
  FLAGS="$FLAGS --breakdown"
fi
# Muse can implement escalated tickets as well as review them. Declare this
# caller's role explicitly so begin cannot route the review schedule into the
# implementation path.
FLAGS="$FLAGS --role review"

PROMPT_TEMPLATE="$(awk 'f{print} /^---$/{f=1}' "$ROUTINE")"
PROMPT_TEMPLATE="${PROMPT_TEMPLATE//OPENING_FLAGS/$FLAGS}"
if printf '%s' "$PROMPT_TEMPLATE" | grep -q OPENING_FLAGS; then
  echo "muse-review: the opening-flags placeholder was not substituted" >&2
  exit 1
fi
if [[ "$PROMPT_TEMPLATE" != *[![:space:]]* ]]; then
  echo "muse-review: $ROUTINE has no prompt after its --- separator" >&2
  exit 1
fi

stop_funnel_session() {
  python3 "$REPO/funnel.py" session-stop >/dev/null 2>&1 || true
}

# Keep runner diagnostics available for the launchd log while also letting the
# EXIT path recognize a shell-level fork failure. A failed fork is printed by
# this shell, not necessarily by Muse, so redirecting only the child would miss
# the exact line that describes the outage.
MUSE_STDERR_FILE="$(mktemp "${TMPDIR:-/tmp}/muse-review-stderr.XXXXXX")"
if [[ -z "$MUSE_STDERR_FILE" ]]; then
  echo "muse-review: could not create a stderr capture" >&2
  exit 1
fi
BEGIN_RUN=""
MUSE_LAUNCH_STATUS=0
MUSE_EXIT_STATUS=""
FORK_FAILURE_SIGNATURE="fork: Resource temporarily unavailable"
STDERR_CAPTURED=0
exec 4>&2
exec 2>"$MUSE_STDERR_FILE"
STDERR_CAPTURED=1

restore_stderr() {
  if (( STDERR_CAPTURED )); then
    exec 2>&4
    exec 4>&-
    STDERR_CAPTURED=0
  fi
}

replay_stderr() {
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "$line" >&2
  done < "$MUSE_STDERR_FILE"
}

has_fork_failure() {
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      *"$FORK_FAILURE_SIGNATURE"*) return 0 ;;
    esac
  done < "$MUSE_STDERR_FILE"
  return 1
}

is_fork_exit() {
  # EAGAIN is errno 35 on macOS and 11 on Linux. The runner is scheduled on
  # macOS, while the latter keeps the contract testable on the CI platform.
  case "${1:-}" in
    11|35) return 0 ;;
  esac
  return 1
}

# Keep one error shape for runner failures: the heartbeat gets the concise
# diagnostic, while the full stderr remains in launchd's ordinary error log.
failure() {
  local note="$1"
  if [[ -z "$BEGIN_RUN" ]]; then
    echo "muse-review: $note (no run id to finish)" >&2
    return 1
  fi
  if ! python3 "$REPO/heartbeat.py" finish --agent muse --run "$BEGIN_RUN" \
      --outcome errored --note "$note"; then
    echo "muse-review: could not finish errored run" >&2
    return 1
  fi
  return 0
}

on_exit() {
  local exit_status=$?
  local fork_failure=0

  if has_fork_failure || is_fork_exit "$MUSE_EXIT_STATUS" \
    || is_fork_exit "$MUSE_LAUNCH_STATUS"; then
    fork_failure=1
  fi

  restore_stderr
  replay_stderr
  if (( fork_failure )); then
    failure "$FORK_FAILURE_SIGNATURE" || true
    # A fork failure is an errored run even when the shell happened to report
    # success after its asynchronous launch path failed.
    exit_status=1
  fi
  rm -f -- "$MUSE_STDERR_FILE"
  stop_funnel_session
  trap - EXIT
  exit "$exit_status"
}
trap on_exit EXIT

# Keep the funnel's Project view in one disposable process for this Muse run.
# The server prints its loopback endpoint through an inherited pipe; it does not
# read GitHub until the first client command arrives, so `begin` still sees the
# live Project when it claims work. No endpoint or Project data is written to
# disk, and the session ends with this runner.
exec 3< <(
  FUNNEL_SESSION= FUNNEL_SESSION_SERVER=1 \
    python3 "$REPO/funnel.py" session-server --parent-pid "$$"
)
FUNNEL_SESSION=""
if ! IFS= read -r FUNNEL_SESSION <&3; then
  echo "muse-review: could not start the per-run funnel session" >&2
  exec 3<&-
  exit 1
fi
exec 3<&-
export FUNNEL_SESSION

# Own the opening poll. Empty polls must not launch a model: `begin` has already
# recorded the heartbeat and made the gate decision, so a stop can finish the run
# here without ever invoking `muse exec`. The JSON is also the exact result the
# model sees for a non-empty poll; it must not have to repeat the claim path.
BEGIN_JSON="$(python3 "$REPO/funnel.py" begin --agent muse $FLAGS)"
begin_status=$?
if (( begin_status != 0 )); then
  echo "muse-review: funnel begin failed (exit $begin_status)" >&2
  exit "$begin_status"
fi

begin_value() {
  local key="$1"
  printf '%s\n' "$BEGIN_JSON" | python3 -c '
import json
import sys

try:
    value = json.load(sys.stdin)[sys.argv[1]]
except (KeyError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
if value is None:
    raise SystemExit(1)
print(value)
' "$key"
}

if ! BEGIN_DO="$(begin_value do)" \
  || ! BEGIN_GATE="$(begin_value gate)" \
  || ! BEGIN_RUN="$(begin_value run)"; then
  echo "muse-review: funnel begin returned invalid JSON" >&2
  exit 1
fi

if [[ "$BEGIN_DO" == "stop" ]]; then
  case "$BEGIN_GATE" in
    over) STOP_OUTCOME="skipped-over-pace" ;;
    unknown) STOP_OUTCOME="skipped-usage-unknown" ;;
    reserve) STOP_OUTCOME="skipped-api-reserve" ;;
    *) STOP_OUTCOME="nothing-to-do" ;;
  esac
  if ! python3 "$REPO/heartbeat.py" finish --agent muse --run "$BEGIN_RUN" \
      --outcome "$STOP_OUTCOME"; then
    echo "muse-review: could not finish the stopped run" >&2
    exit 1
  fi
  exit 0
fi

case "$BEGIN_DO" in
  review|breakdown|shape) ;;
  *)
    echo "muse-review: funnel begin returned unknown job '$BEGIN_DO'" >&2
    failure "funnel begin returned unknown job '$BEGIN_DO'" || true
    exit 1
    ;;
esac

PROMPT="${PROMPT_TEMPLATE//BEGIN_JSON/$BEGIN_JSON}"
if printf '%s' "$PROMPT" | grep -q BEGIN_JSON; then
  echo "muse-review: the begin-json placeholder was not substituted" >&2
  exit 1
fi
if [[ "$PROMPT" != *[![:space:]]* ]]; then
  echo "muse-review: $ROUTINE has no prompt after its --- separator" >&2
  exit 1
fi

# --model muse-spark-1.3, NOT -contributor. The contributor variant is the CLI
# default and carries "Your content ... may be used for product improvement".
# This repository is private and holds Nate's plans, budgets and decisions, and
# privacy is why he chose Muse in the first place. Both were confirmed working
# on his plan on 2026-09-07; this is the one without the notice.
#
# --sandbox-network enabled is required, not optional: the default is
# `proxy-only`, under which `gh` fails with `context deadline exceeded` after
# about a minute and reports the PR as unreadable.
#
# --disable-write blocks non-shell workspace writes. It is not the whole safety
# story -- the routine being read-only by instruction is -- because
# --approval-mode never means *never ask*, not *never allow*.
#
# Wall-clock bound (#392). `--max-model-steps` caps steps, not time: a hung
# model stream or tool consumes no steps, and launchd runs one instance per
# job, so a run that never ends skips every scheduled run after it. Measured
# twice on 2026-09-09 — 1,128 minutes, then 2h31m — against a 0.3-minute
# median. Twenty minutes is an order of magnitude past any legitimate job.
# A killed run finishes `errored` with the kill in its note, resolved from the
# one open start, so the watchdog sees a run that was stopped, not one that
# vanished. Portable bash: macOS ships no coreutils `timeout`.
# `perl setpgrp` gives the run its own process group, so the bound can kill
# the whole tree (muse and any shell tool it spawned) with one signal. macOS
# ships perl and no `setsid`.
perl -e 'setpgrp(0, 0); exec @ARGV or die "exec: $!"' "$MUSE_BIN" exec \
  --model muse-spark-1.3 \
  --reasoning-effort "$EFFORT" \
  --disable-write \
  --sandbox-network enabled \
  --max-model-steps 60 \
  --no-foreign-personal-context \
  --workspace "$WORKSPACE" \
  --json \
  "$PROMPT" &
muse_launch_status=$?
MUSE_LAUNCH_STATUS="$muse_launch_status"
muse_pid=$!
killed_marker="$(mktemp "${TMPDIR:-/tmp}/muse-review-killed.XXXXXX")"
rm -f "$killed_marker"

if (( muse_launch_status == 0 )); then
  (
    # Sleep in the background so a TERM to this subshell (the normal path, when
    # the run finished inside the bound) takes the sleep with it instead of
    # leaving an orphan holding the log pipe open for the rest of the bound.
    sleep "$BOUND_SECONDS" &
    sleep_pid=$!
    trap 'kill "$sleep_pid" 2>/dev/null; exit 0' TERM
    wait "$sleep_pid"
    if kill -0 "$muse_pid" 2>/dev/null; then
      echo "muse-review: killing run after ${BOUND_SECONDS}s ($TIER schedule)" >&2
      : > "$killed_marker"
      # Record the kill before the hard kill, so a run that dies slowly still
      # leaves an honest finish behind.
      python3 "$REPO/heartbeat.py" finish --agent muse --outcome errored \
        --note "killed after $((BOUND_SECONDS / 60)) minutes: $TIER schedule run exceeded the wall-clock bound (#392)" >&2
      kill -TERM -- "-$muse_pid" 2>/dev/null
      sleep 5
      kill -KILL -- "-$muse_pid" 2>/dev/null
    fi
  ) &
  bound_pid=$!

  wait "$muse_pid"
  status=$?
  MUSE_EXIT_STATUS="$status"
  if [[ -e "$killed_marker" ]]; then
    wait "$bound_pid" 2>/dev/null
    rm -f "$killed_marker"
    exit 124
  fi
  kill "$bound_pid" 2>/dev/null
  wait "$bound_pid" 2>/dev/null
else
  # An asynchronous launch can fail before it has a child to wait for. Keep
  # its status for on_exit so the fork path still gets one errored finish.
  status="$muse_launch_status"
  MUSE_EXIT_STATUS="$status"
fi
exit "$status"
